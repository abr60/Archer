/* ==========================================================================
   Rofi Wallpaper Picker — Text Active, Scrollbar Disabled
   ========================================================================== */

@import "matugen.rasi"

configuration {
    show-icons:        true;
    hover-select:      true;
    me-select-entry:   "";
    me-accept-entry:   "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @on-surface-variant;
    font:             "Maple Mono NF 10";
}

window {
    width:            810px; /* Restored to original compact width */
    background-color: @surface;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    4px;
    location:         center;
    anchor:           center;
    padding:          6px;
}

mainbox {
    children: [ listview ];
    padding:  0;
    spacing:  0;
}

inputbar  { enabled: false; }
scrollbar { enabled: false; } /* Explicitly disabled globally */

listview {
    columns:       5;
    lines:         2;
    spacing:       4px;
    padding:       4px;
    fixed-columns: true;
    fixed-height:  true;
    dynamic:       true;
    cycle:         true;
}

element {
    orientation:      vertical;
    cursor:           pointer;
    padding:          6px;
    spacing:          4px; /* Tight spacer between image and text layout */
    border-radius:    4px;
}

element selected,
element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @surface;
    border:           20px;
    border-radius:    40 3 40 3;
    border-color:     transparent;
}

element-icon {
    size:             170px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    border-radius:    4px;
}

element-text {
    enabled:          true;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}