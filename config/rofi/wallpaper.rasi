/* ==========================================================================
   Rofi Wallpaper Picker — Text Active, Scrollbar Disabled
   ========================================================================== */

@import "matugen.rasi"

configuration {
    show-icons:        true;
    hover-select:      true;
    me-select-entry:   "";
    me-accept-entry:   "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @on-surface-variant;
    font:             "Maple Mono NF 12";
}

window {
    width:            950px; /* Compact width layout */
    background-color: @surface;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    4px;
    location:         center;
    anchor:           center;
    padding:          6px;
}

mainbox {
    children: [ listview ];
    padding:  0;
    spacing:  0;
}

inputbar  { enabled: false; }
scrollbar { enabled: false; } 

listview {
    columns:       5;
    lines:         2;
    spacing:       4px;
    padding:       4px;
    fixed-columns: true;
    fixed-height:  true;
    dynamic:       true;
    cycle:         true;
}

element {
    orientation:      vertical;
    cursor:           pointer;
    padding:          4px 2px;
    spacing:          2px; /* Tight spacer between image and text layout */
    border-radius:    4px;
}

/* ─── State Modifiers (Direct Selection Fixes) ───────────────────────────── */

/* Reset default selection overlay backgrounds completely */
element normal.normal,
element normal.active,
element selected.normal,
element selected.active {
    background-color: transparent;
    border:           0px;
}

/* Hover / Selected State for Regular Items — Force Text to Blue */
element selected.normal {
    text-color: #268bd2;
}

/* Active Theme State when NOT hovered — Force Text to Green */
element normal.active {
    text-color: #859900;
}

/* Active Theme State when SIMULTANEOUSLY selected/focused on launch — Force Text to Green */
element selected.active {
    text-color: #859900;
}

/* ─── Element Components ─────────────────────────────────────────────────── */

element-icon {
    size:             185px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    border-radius:    4px;
    text-color:       inherit; /* Keep images unaffected by parent text color shifts */
}

element-text {
    enabled:          true;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
}