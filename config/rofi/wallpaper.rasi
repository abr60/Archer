/* ==========================================================================
   Rofi Wallpaper Picker — matugen M3 tokens, aligned with clipboard/emoji
   Layout and dimensions unchanged from original
   ========================================================================== */

@import "matugen.rasi"

configuration {
    show-icons:        true;
    icon-theme:        "Papirus";
    hover-select:      true;
    me-select-entry:   "";
    me-accept-entry:   "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @on-surface-variant;
    font:             "Maple Mono NF 12";
}

window {
    width:            810px;
    background-color: @surface;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    4px;
    location:         center;
    anchor:           center;
    padding:          6px;
}

mainbox {
    children: [ listview ];
    padding:  0;
    spacing:  0;
}

inputbar  { enabled: false; }
scrollbar { enabled: false; }

listview {
    columns:       5;
    lines:         2;
    spacing:       4px;
    padding:       4px;
    fixed-columns: true;
    fixed-height:  true;
    dynamic:       true;
    cycle:         true;
    scrollbar:     false;
}

element {
    orientation:      vertical;
    cursor:           pointer;
    padding:          4px;
    margin:           0px;
    border-radius:    4px;
    background-color: transparent;
    border:           0px;
    border-color:     transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    border-color:     transparent;
}

element selected,
element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @surface;
    border:           20px;
    border-radius:    40 3 40 3;
    border-color:     transparent;
}

element-icon {
    size:             170px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    border-radius:    4px;
}

element-text {
    enabled: false;
}
