/* ==========================================================================
   Rofi Applications Theme - Compact Consolidated Row Design
   ========================================================================== */

@import "matugen.rasi"


configuration {
    display-drun:        "Pkgs";
    matching: "prefix";
    tokenize: false;
    drun-match-fields: "name";
    history: false;
    sort: false;
}

* {
    background-color: transparent;
    text-color:       @on-surface-variant;
    font:             "JetBrains Mono 12";
}

window {
    background-color: @surface;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    1px;
    width:            520px;
    padding:          14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
}

inputbar {
    background-color: @surface-container-low;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    1px;
    padding:          4px 12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @outline;
    margin:     0px 6px 0px 0px;
}

entry {
    placeholder-color: @outline;
    text-color:        @on-surface-variant;
}

listview {
    border:        1px;
    border-radius: 1px;
    border-color:  @outline-variant;
    lines:         7;
    columns:       1;
    spacing:       0px;
    fixed-height:  false;
}

element {
    background-color: @surface-container-low;
    border:           0px 0px 1px 0px;
    border-color:     @outline-variant;
    border-radius:    1px;
    padding:          10px 14px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal normal,
element alternate normal {
    background-color: @surface-container-low;
    text-color:       @on-surface-variant;
}

element selected normal {
    background-color: @surface-container-high;
    text-color:       @on-surface;
}

element-icon {
    background-color: transparent;
    size:             20px;
    margin:           0px 12px 0px 0px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    expand:           true;
}