* {
    primary: #006a6a;
    primary-fixed: #9cf1f1;
    primary-fixed-alpha: rgba(156, 241, 241, 0.2);
    primary-fixed-dim: #80d4d4;
    on-primary: #ffffff;
    on-primary-fixed: #002020;
    on-primary-fixed-variant: #004f50;
    primary-container: #9cf1f1;
    on-primary-container: #002020;
    secondary: #4a6363;
    secondary-fixed: #cce8e7;
    secondary-fixed-dim: #b0cccb;
    on-secondary: #ffffff;
    on-secondary-fixed: #051f1f;
    on-secondary-fixed-variant: #324b4b;
    secondary-container: #cce8e7;
    on-secondary-container: #051f1f;
    tertiary: #4b607c;
    tertiary-fixed: #d3e4ff;
    tertiary-fixed-dim: #b3c8e9;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #041c35;
    on-tertiary-fixed-variant: #344863;
    tertiary-container: #d3e4ff;
    on-tertiary-container: #041c35;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f4fbfa;
    surface-alpha: rgba(244, 251, 250, 0.7);
    on-surface: #161d1d;
    on-surface-variant: #3f4948;
    outline: #6f7979;
    outline-variant: #bec9c8;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2b3231;
    inverse-on-surface: #ecf2f1;
    inverse-primary: #80d4d4;
    surface-dim: #d5dbdb;
    surface-bright: #f4fbfa;
    surface-container-lowest: #ffffff;
    surface-container-low: #eff5f4;
    surface-container: #e9efee;
    surface-container-high: #e3e9e9;
    surface-container-highest: #dde4e3;
}