* {
    primary: #b5007a;
    primary-fixed: #ffd8e7;
    primary-fixed-alpha: rgba(255, 216, 231, 0.2);
    primary-fixed-dim: #ffafd3;
    on-primary: #ffffff;
    on-primary-fixed: #3d0026;
    on-primary-fixed-variant: #8b005c;
    primary-container: #ffd8e7;
    on-primary-container: #3d0026;
    secondary: #7f525c;
    secondary-fixed: #ffd9e0;
    secondary-fixed-dim: #f1b7c4;
    on-secondary: #ffffff;
    on-secondary-fixed: #32101a;
    on-secondary-fixed-variant: #643b45;
    secondary-container: #ffd9e0;
    on-secondary-container: #32101a;
    tertiary: #8b4c4f;
    tertiary-fixed: #ffdad9;
    tertiary-fixed-dim: #ffb3b4;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #380b10;
    on-tertiary-fixed-variant: #6f3638;
    tertiary-container: #ffdad9;
    on-tertiary-container: #380b10;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f8;
    surface-alpha: rgba(255, 248, 248, 0.7);
    on-surface: #25181d;
    on-surface-variant: #524249;
    outline: #857279;
    outline-variant: #d7c1c8;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #3b2c32;
    inverse-on-surface: #ffecf2;
    inverse-primary: #ffafd3;
    surface-dim: #ebd4dc;
    surface-bright: #fff8f8;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff0f4;
    surface-container: #ffe8ef;
    surface-container-high: #fae2ea;
    surface-container-highest: #f4dce4;
}