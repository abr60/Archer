* {
    primary: #875300;
    primary-fixed: #ffddba;
    primary-fixed-alpha: rgba(255, 221, 186, 0.2);
    primary-fixed-dim: #ffb964;
    on-primary: #ffffff;
    on-primary-fixed: #2b1700;
    on-primary-fixed-variant: #663e00;
    primary-container: #ffddba;
    on-primary-container: #2b1700;
    secondary: #745a2f;
    secondary-fixed: #ffdead;
    secondary-fixed-dim: #e4c18d;
    on-secondary: #ffffff;
    on-secondary-fixed: #281900;
    on-secondary-fixed-variant: #5a4319;
    secondary-container: #ffdead;
    on-secondary-container: #281900;
    tertiary: #735b1a;
    tertiary-fixed: #ffdf96;
    tertiary-fixed-dim: #e3c377;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #251a00;
    on-tertiary-fixed-variant: #594401;
    tertiary-container: #ffdf96;
    on-tertiary-container: #251a00;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f4;
    surface-alpha: rgba(255, 248, 244, 0.7);
    on-surface: #241a0e;
    on-surface-variant: #524436;
    outline: #857464;
    outline-variant: #d7c3b0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #3a2e21;
    inverse-on-surface: #ffeedf;
    inverse-primary: #ffb964;
    surface-dim: #ebd7c3;
    surface-bright: #fff8f4;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff1e6;
    surface-container: #ffead8;
    surface-container-high: #fae5d1;
    surface-container-highest: #f4dfcb;
}