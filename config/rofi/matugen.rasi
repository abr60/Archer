* {
    primary: #07658e;
    primary-fixed: #c7e7ff;
    primary-fixed-alpha: rgba(199, 231, 255, 0.2);
    primary-fixed-dim: #89cefd;
    on-primary: #ffffff;
    on-primary-fixed: #001e2e;
    on-primary-fixed-variant: #004c6d;
    primary-container: #81c6f4;
    on-primary-container: #00344c;
    secondary: #496173;
    secondary-fixed: #cce6fb;
    secondary-fixed-dim: #b0cade;
    on-secondary: #ffffff;
    on-secondary-fixed: #021e2d;
    on-secondary-fixed-variant: #314a5a;
    secondary-container: #cce6fb;
    on-secondary-container: #334b5b;
    tertiary: #794d8a;
    tertiary-fixed: #f8d8ff;
    tertiary-fixed-dim: #e8b4f9;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #300542;
    on-tertiary-fixed-variant: #5f3670;
    tertiary-container: #dfacf0;
    on-tertiary-container: #471e58;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f8f9fd;
    surface-alpha: rgba(248, 249, 253, 0.7);
    on-surface: #191c1f;
    on-surface-variant: #40484e;
    outline: #70787f;
    outline-variant: #c0c7cf;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2d3134;
    inverse-on-surface: #eff1f4;
    inverse-primary: #89cefd;
    surface-dim: #d8dade;
    surface-bright: #f8f9fd;
    surface-container-lowest: #ffffff;
    surface-container-low: #f2f4f7;
    surface-container: #eceef2;
    surface-container-high: #e6e8ec;
    surface-container-highest: #e0e2e6;
}