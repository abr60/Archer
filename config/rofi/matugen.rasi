* {
    primary: #006a6a;
    primary-fixed: #96f2f2;
    primary-fixed-alpha: rgba(150, 242, 242, 0.2);
    primary-fixed-dim: #79d5d5;
    on-primary: #ffffff;
    on-primary-fixed: #002020;
    on-primary-fixed-variant: #004f50;
    primary-container: #61bebe;
    on-primary-container: #002a2a;
    secondary: #446464;
    secondary-fixed: #c6e9e9;
    secondary-fixed-dim: #abcdcc;
    on-secondary: #ffffff;
    on-secondary-fixed: #002020;
    on-secondary-fixed-variant: #2c4c4c;
    secondary-container: #c3e6e6;
    on-secondary-container: #2b4c4b;
    tertiary: #8f4c2b;
    tertiary-fixed: #ffdbcc;
    tertiary-fixed-dim: #ffb694;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #351000;
    on-tertiary-fixed-variant: #723616;
    tertiary-container: #f09b73;
    on-tertiary-container: #441600;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f6faf9;
    surface-alpha: rgba(246, 250, 249, 0.7);
    on-surface: #181c1c;
    on-surface-variant: #3e4949;
    outline: #6e7979;
    outline-variant: #bdc9c8;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2d3131;
    inverse-on-surface: #eef1f1;
    inverse-primary: #79d5d5;
    surface-dim: #d7dbda;
    surface-bright: #f6faf9;
    surface-container-lowest: #ffffff;
    surface-container-low: #f0f4f4;
    surface-container: #ebefee;
    surface-container-high: #e5e9e8;
    surface-container-highest: #dfe3e2;
}