* {
    primary: #686000;
    primary-fixed: #f7e600;
    primary-fixed-alpha: rgba(247, 230, 0, 0.2);
    primary-fixed-dim: #d9c900;
    on-primary: #ffffff;
    on-primary-fixed: #1f1c00;
    on-primary-fixed-variant: #4e4800;
    primary-container: #f7e600;
    on-primary-container: #1f1c00;
    secondary: #5d6236;
    secondary-fixed: #e2e7b0;
    secondary-fixed-dim: #c5cb96;
    on-secondary: #ffffff;
    on-secondary-fixed: #1a1e00;
    on-secondary-fixed-variant: #454a21;
    secondary-container: #e2e7b0;
    on-secondary-container: #1a1e00;
    tertiary: #506531;
    tertiary-fixed: #d2eca9;
    tertiary-fixed-dim: #b6cf90;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #111f00;
    on-tertiary-fixed-variant: #394d1b;
    tertiary-container: #d2eca9;
    on-tertiary-container: #111f00;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff9e5;
    surface-alpha: rgba(255, 249, 229, 0.7);
    on-surface: #1e1c0e;
    on-surface-variant: #4a4736;
    outline: #7b7764;
    outline-variant: #ccc7b1;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #333121;
    inverse-on-surface: #f7f1d9;
    inverse-primary: #d9c900;
    surface-dim: #dfdac3;
    surface-bright: #fff9e5;
    surface-container-lowest: #ffffff;
    surface-container-low: #faf4dc;
    surface-container: #f4eed7;
    surface-container-high: #eee8d1;
    surface-container-highest: #e8e3cc;
}