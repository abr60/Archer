* {
    primary: #e3c28c;
    primary-fixed: #ffdeaa;
    primary-fixed-alpha: rgba(255, 222, 170, 0.2);
    primary-fixed-dim: #e3c28c;
    on-primary: #412d05;
    on-primary-fixed: #271900;
    on-primary-fixed-variant: #5a4319;
    primary-container: #7f6538;
    on-primary-container: #ffffff;
    secondary: #d6c4aa;
    secondary-fixed: #f3e0c5;
    secondary-fixed-dim: #d6c4aa;
    on-secondary: #3a2f1d;
    on-secondary-fixed: #231a0a;
    on-secondary-fixed-variant: #514531;
    secondary-container: #514531;
    on-secondary-container: #f0ddc3;
    tertiary: #c0cc99;
    tertiary-fixed: #dce8b3;
    tertiary-fixed-dim: #c0cc99;
    on-tertiary: #2b340f;
    on-tertiary-fixed: #161f00;
    on-tertiary-fixed-variant: #414b23;
    tertiary-container: #636e43;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #16130f;
    surface-alpha: rgba(22, 19, 15, 0.7);
    on-surface: #e9e1db;
    on-surface-variant: #d0c5b6;
    outline: #998f82;
    outline-variant: #4d463b;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e9e1db;
    inverse-on-surface: #33302c;
    inverse-primary: #735a2e;
    surface-dim: #16130f;
    surface-bright: #3c3934;
    surface-container-lowest: #100e0a;
    surface-container-low: #1e1b17;
    surface-container: #221f1b;
    surface-container-high: #2d2925;
    surface-container-highest: #383430;
}