* {
    primary: #695f00;
    primary-fixed: #fae500;
    primary-fixed-alpha: rgba(250, 229, 0, 0.2);
    primary-fixed-dim: #dbc900;
    on-primary: #ffffff;
    on-primary-fixed: #1f1c00;
    on-primary-fixed-variant: #4f4800;
    primary-container: #fae500;
    on-primary-container: #1f1c00;
    secondary: #5d6136;
    secondary-fixed: #e3e7af;
    secondary-fixed-dim: #c6ca95;
    on-secondary: #ffffff;
    on-secondary-fixed: #1a1d00;
    on-secondary-fixed-variant: #464a20;
    secondary-container: #e3e7af;
    on-secondary-container: #1a1d00;
    tertiary: #516530;
    tertiary-fixed: #d3eba8;
    tertiary-fixed-dim: #b7cf8f;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #121f00;
    on-tertiary-fixed-variant: #3a4d1a;
    tertiary-container: #d3eba8;
    on-tertiary-container: #121f00;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff9e7;
    surface-alpha: rgba(255, 249, 231, 0.7);
    on-surface: #1e1c0e;
    on-surface-variant: #4a4736;
    outline: #7b7764;
    outline-variant: #ccc7b0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #333121;
    inverse-on-surface: #f7f1d9;
    inverse-primary: #dbc900;
    surface-dim: #e0dac3;
    surface-bright: #fff9e7;
    surface-container-lowest: #ffffff;
    surface-container-low: #faf4dc;
    surface-container: #f4eed7;
    surface-container-high: #eee8d1;
    surface-container-highest: #e9e3cc;
}