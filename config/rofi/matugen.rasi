* {
    primary: #ffd7ab;
    primary-fixed: #ffddb8;
    primary-fixed-alpha: rgba(255, 221, 184, 0.2);
    primary-fixed-dim: #ffb960;
    on-primary: #472a00;
    on-primary-fixed: #2a1700;
    on-primary-fixed-variant: #653e00;
    primary-container: #feb351;
    on-primary-container: #4b2c00;
    secondary: #e8bf91;
    secondary-fixed: #ffddb8;
    secondary-fixed-dim: #e8bf91;
    on-secondary: #442b09;
    on-secondary-fixed: #2a1700;
    on-secondary-fixed-variant: #5d411d;
    secondary-container: #5d411d;
    on-secondary-container: #ffdab1;
    tertiary: #d8e679;
    tertiary-fixed: #ddeb7d;
    tertiary-fixed-dim: #c1cf64;
    on-tertiary: #2d3400;
    on-tertiary-fixed: #191e00;
    on-tertiary-fixed-variant: #434b00;
    tertiary-container: #bcca60;
    on-tertiary-container: #303600;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #18120c;
    surface-alpha: rgba(24, 18, 12, 0.7);
    on-surface: #ede0d5;
    on-surface-variant: #d6c3b1;
    outline: #9f8e7d;
    outline-variant: #524436;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ede0d5;
    inverse-on-surface: #362f28;
    inverse-primary: #855300;
    surface-dim: #18120c;
    surface-bright: #3f3830;
    surface-container-lowest: #130d07;
    surface-container-low: #211a14;
    surface-container: #251e18;
    surface-container-high: #302921;
    surface-container-highest: #3b332c;
}