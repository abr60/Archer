* {
    primary: #29693a;
    primary-fixed: #aef3b7;
    primary-fixed-alpha: rgba(174, 243, 183, 0.2);
    primary-fixed-dim: #93d69c;
    on-primary: #ffffff;
    on-primary-fixed: #00210a;
    on-primary-fixed-variant: #0c5226;
    primary-container: #438351;
    on-primary-container: #ffffff;
    secondary: #4b644e;
    secondary-fixed: #cdeacd;
    secondary-fixed-dim: #b2ceb2;
    on-secondary: #ffffff;
    on-secondary-fixed: #09200e;
    on-secondary-fixed-variant: #344c37;
    secondary-container: #cdeacd;
    on-secondary-container: #354e38;
    tertiary: #1b6292;
    tertiary-fixed: #cde5ff;
    tertiary-fixed-dim: #94ccff;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #001d32;
    on-tertiary-fixed-variant: #004b74;
    tertiary-container: #3c7bac;
    on-tertiary-container: #ffffff;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f8faf3;
    surface-alpha: rgba(248, 250, 243, 0.7);
    on-surface: #191d19;
    on-surface-variant: #404940;
    outline: #70796f;
    outline-variant: #c0c9bd;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2e312d;
    inverse-on-surface: #eff2eb;
    inverse-primary: #93d69c;
    surface-dim: #d8dbd4;
    surface-bright: #f8faf3;
    surface-container-lowest: #ffffff;
    surface-container-low: #f2f5ee;
    surface-container: #ecefe8;
    surface-container-high: #e6e9e2;
    surface-container-highest: #e1e3dd;
}