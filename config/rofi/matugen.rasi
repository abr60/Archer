* {
    primary: #ffb59d;
    primary-fixed: #ffdbd0;
    primary-fixed-alpha: rgba(255, 219, 208, 0.2);
    primary-fixed-dim: #ffb59d;
    on-primary: #5a1b04;
    on-primary-fixed: #390c00;
    on-primary-fixed-variant: #783118;
    primary-container: #a35236;
    on-primary-container: #ffffff;
    secondary: #f1baa9;
    secondary-fixed: #ffdbd0;
    secondary-fixed-dim: #f1baa9;
    on-secondary: #49271c;
    on-secondary-fixed: #301309;
    on-secondary-fixed-variant: #633d30;
    secondary-container: #663f33;
    on-secondary-container: #ffddd2;
    tertiary: #d2ca61;
    tertiary-fixed: #efe67a;
    tertiary-fixed-dim: #d2ca61;
    on-tertiary: #353100;
    on-tertiary-fixed: #1f1c00;
    on-tertiary-fixed-variant: #4d4800;
    tertiary-container: #b6ae49;
    on-tertiary-container: #242100;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #19120f;
    surface-alpha: rgba(25, 18, 15, 0.7);
    on-surface: #efdfda;
    on-surface-variant: #dac1ba;
    outline: #a28c85;
    outline-variant: #55433d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #efdfda;
    inverse-on-surface: #382e2b;
    inverse-primary: #96482d;
    surface-dim: #19120f;
    surface-bright: #413734;
    surface-container-lowest: #140c0a;
    surface-container-low: #221a17;
    surface-container: #261e1b;
    surface-container-high: #312825;
    surface-container-highest: #3c3330;
}