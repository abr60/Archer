* {
    primary: #ecbfd2;
    primary-fixed: #ffd8e7;
    primary-fixed-alpha: rgba(255, 216, 231, 0.2);
    primary-fixed-dim: #e7bacd;
    on-primary: #452736;
    on-primary-fixed: #2d1320;
    on-primary-fixed-variant: #5e3d4c;
    primary-container: #cfa4b6;
    on-primary-container: #381c2a;
    secondary: #d8c1c9;
    secondary-fixed: #f5dce5;
    secondary-fixed-dim: #d8c1c9;
    on-secondary: #3b2c33;
    on-secondary-fixed: #25181e;
    on-secondary-fixed-variant: #534249;
    secondary-container: #534249;
    on-secondary-container: #f2dae2;
    tertiary: #f5bfac;
    tertiary-fixed: #ffdbcf;
    tertiary-fixed-dim: #f0bba8;
    on-tertiary: #49281b;
    on-tertiary-fixed: #301308;
    on-tertiary-fixed-variant: #633d30;
    tertiary-container: #d7a492;
    on-tertiary-container: #3b1c10;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #161214;
    surface-alpha: rgba(22, 18, 20, 0.7);
    on-surface: #e9e0e2;
    on-surface-variant: #d2c3c7;
    outline: #9b8d92;
    outline-variant: #4f4448;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e9e0e2;
    inverse-on-surface: #332f30;
    inverse-primary: #785464;
    surface-dim: #161214;
    surface-bright: #3c3839;
    surface-container-lowest: #100d0e;
    surface-container-low: #1e1b1c;
    surface-container: #221f20;
    surface-container-high: #2d292a;
    surface-container-highest: #383435;
}