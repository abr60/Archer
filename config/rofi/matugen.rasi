* {
    primary: #efbf6c;
    primary-fixed: #ffdeaa;
    primary-fixed-alpha: rgba(255, 222, 170, 0.2);
    primary-fixed-dim: #efbf6c;
    on-primary: #422c00;
    on-primary-fixed: #271900;
    on-primary-fixed-variant: #5f4100;
    primary-container: #b48a3c;
    on-primary-container: #000000;
    secondary: #ddc39b;
    secondary-fixed: #fadfb5;
    secondary-fixed-dim: #ddc39b;
    on-secondary: #3e2e11;
    on-secondary-fixed: #271902;
    on-secondary-fixed-variant: #564426;
    secondary-container: #584628;
    on-secondary-container: #fce0b7;
    tertiary: #bdce7f;
    tertiary-fixed: #d9eb98;
    tertiary-fixed-dim: #bdce7f;
    on-tertiary: #2a3500;
    on-tertiary-fixed: #171e00;
    on-tertiary-fixed-variant: #3f4c09;
    tertiary-container: #88984e;
    on-tertiary-container: #000000;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #16130d;
    surface-alpha: rgba(22, 19, 13, 0.7);
    on-surface: #eae1d7;
    on-surface-variant: #d2c5b3;
    outline: #9b8f7f;
    outline-variant: #4f4538;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #eae1d7;
    inverse-on-surface: #343029;
    inverse-primary: #7c580b;
    surface-dim: #16130d;
    surface-bright: #3d3832;
    surface-container-lowest: #110e08;
    surface-container-low: #1f1b15;
    surface-container: #231f19;
    surface-container-high: #2e2923;
    surface-container-highest: #39342d;
}