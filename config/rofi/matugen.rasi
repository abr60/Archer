* {
    primary: #765b0b;
    primary-fixed: #ffdf97;
    primary-fixed-alpha: rgba(255, 223, 151, 0.2);
    primary-fixed-dim: #e6c26c;
    on-primary: #ffffff;
    on-primary-fixed: #251a00;
    on-primary-fixed-variant: #5a4400;
    primary-container: #ffdf97;
    on-primary-container: #251a00;
    secondary: #6a5d3f;
    secondary-fixed: #f3e1bb;
    secondary-fixed-dim: #d7c5a0;
    on-secondary: #ffffff;
    on-secondary-fixed: #231a04;
    on-secondary-fixed-variant: #51452a;
    secondary-container: #f3e1bb;
    on-secondary-container: #231a04;
    tertiary: #496548;
    tertiary-fixed: #caebc6;
    tertiary-fixed-dim: #afcfab;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #06210a;
    on-tertiary-fixed-variant: #324d32;
    tertiary-container: #caebc6;
    on-tertiary-container: #06210a;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f1;
    surface-alpha: rgba(255, 248, 241, 0.7);
    on-surface: #1f1b13;
    on-surface-variant: #4d4639;
    outline: #7e7667;
    outline-variant: #d0c5b4;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #343027;
    inverse-on-surface: #f9efe2;
    inverse-primary: #e6c26c;
    surface-dim: #e2d9cc;
    surface-bright: #fff8f1;
    surface-container-lowest: #ffffff;
    surface-container-low: #fcf2e5;
    surface-container: #f6eddf;
    surface-container-high: #f0e7d9;
    surface-container-highest: #eae1d4;
}