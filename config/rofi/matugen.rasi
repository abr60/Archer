* {
    primary: #93d69c;
    primary-fixed: #aef3b7;
    primary-fixed-alpha: rgba(174, 243, 183, 0.2);
    primary-fixed-dim: #93d69c;
    on-primary: #003916;
    on-primary-fixed: #00210a;
    on-primary-fixed-variant: #0c5226;
    primary-container: #438351;
    on-primary-container: #ffffff;
    secondary: #b2ceb2;
    secondary-fixed: #cdeacd;
    secondary-fixed-dim: #b2ceb2;
    on-secondary: #1e3622;
    on-secondary-fixed: #09200e;
    on-secondary-fixed-variant: #344c37;
    secondary-container: #39513c;
    on-secondary-container: #d3efd2;
    tertiary: #94ccff;
    tertiary-fixed: #cde5ff;
    tertiary-fixed-dim: #94ccff;
    on-tertiary: #003352;
    on-tertiary-fixed: #001d32;
    on-tertiary-fixed-variant: #004b74;
    tertiary-container: #3c7bac;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #111410;
    surface-alpha: rgba(17, 20, 16, 0.7);
    on-surface: #e1e3dd;
    on-surface-variant: #c0c9bd;
    outline: #8a9388;
    outline-variant: #404940;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e3dd;
    inverse-on-surface: #2e312d;
    inverse-primary: #2a6b3b;
    surface-dim: #111410;
    surface-bright: #363a36;
    surface-container-lowest: #0b0f0b;
    surface-container-low: #191d19;
    surface-container: #1d211c;
    surface-container-high: #272b27;
    surface-container-highest: #323631;
}