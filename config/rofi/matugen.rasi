* {
    primary: #005db7;
    primary-fixed: #d6e3ff;
    primary-fixed-alpha: rgba(214, 227, 255, 0.2);
    primary-fixed-dim: #a9c7ff;
    on-primary: #ffffff;
    on-primary-fixed: #001b3d;
    on-primary-fixed-variant: #00468c;
    primary-container: #d6e3ff;
    on-primary-container: #001b3d;
    secondary: #575c7e;
    secondary-fixed: #dee1ff;
    secondary-fixed-dim: #bfc4eb;
    on-secondary: #ffffff;
    on-secondary-fixed: #131937;
    on-secondary-fixed-variant: #3f4565;
    secondary-container: #dee1ff;
    on-secondary-container: #131937;
    tertiary: #5f588a;
    tertiary-fixed: #e5deff;
    tertiary-fixed-dim: #c8c0f8;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #1b1442;
    on-tertiary-fixed-variant: #474070;
    tertiary-container: #e5deff;
    on-tertiary-container: #1b1442;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f9f9ff;
    surface-alpha: rgba(249, 249, 255, 0.7);
    on-surface: #171c25;
    on-surface-variant: #424751;
    outline: #737782;
    outline-variant: #c2c6d2;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2c303a;
    inverse-on-surface: #edf0fd;
    inverse-primary: #a9c7ff;
    surface-dim: #d6dae6;
    surface-bright: #f9f9ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f0f3ff;
    surface-container: #eaeefa;
    surface-container-high: #e4e8f5;
    surface-container-highest: #dfe2ef;
}