* {
    primary: #974800;
    primary-fixed: #ffdbc7;
    primary-fixed-alpha: rgba(255, 219, 199, 0.2);
    primary-fixed-dim: #ffb688;
    on-primary: #ffffff;
    on-primary-fixed: #311300;
    on-primary-fixed-variant: #733600;
    primary-container: #ffdbc7;
    on-primary-container: #311300;
    secondary: #7a5832;
    secondary-fixed: #ffdcbb;
    secondary-fixed-dim: #ebbe90;
    on-secondary: #ffffff;
    on-secondary-fixed: #2c1700;
    on-secondary-fixed-variant: #5f401d;
    secondary-container: #ffdcbb;
    on-secondary-container: #2c1700;
    tertiary: #78591a;
    tertiary-fixed: #ffdea7;
    tertiary-fixed-dim: #e9c177;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #271900;
    on-tertiary-fixed-variant: #5d4202;
    tertiary-container: #ffdea7;
    on-tertiary-container: #271900;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f5;
    surface-alpha: rgba(255, 248, 245, 0.7);
    on-surface: #261910;
    on-surface-variant: #544339;
    outline: #877367;
    outline-variant: #dac2b4;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #3c2d24;
    inverse-on-surface: #ffede4;
    inverse-primary: #ffb688;
    surface-dim: #efd5c7;
    surface-bright: #fff8f5;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff1ea;
    surface-container: #ffeadf;
    surface-container-high: #fde3d5;
    surface-container-highest: #f7ddcf;
}