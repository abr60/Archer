* {
    primary: #bf0032;
    primary-fixed: #ffdada;
    primary-fixed-alpha: rgba(255, 218, 218, 0.2);
    primary-fixed-dim: #ffb3b4;
    on-primary: #ffffff;
    on-primary-fixed: #40000a;
    on-primary-fixed-variant: #920024;
    primary-container: #ffdada;
    on-primary-container: #40000a;
    secondary: #815345;
    secondary-fixed: #ffdbd1;
    secondary-fixed-dim: #f5b8a7;
    on-secondary: #ffffff;
    on-secondary-fixed: #321208;
    on-secondary-fixed-variant: #663c2f;
    secondary-container: #ffdbd1;
    on-secondary-container: #321208;
    tertiary: #87512c;
    tertiary-fixed: #ffdbc7;
    tertiary-fixed-dim: #feb789;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #311300;
    on-tertiary-fixed-variant: #6b3a17;
    tertiary-container: #ffdbc7;
    on-tertiary-container: #311300;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f7;
    surface-alpha: rgba(255, 248, 247, 0.7);
    on-surface: #271818;
    on-surface-variant: #554242;
    outline: #887272;
    outline-variant: #dbc0c0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #3d2c2c;
    inverse-on-surface: #ffedec;
    inverse-primary: #ffb3b4;
    surface-dim: #efd4d3;
    surface-bright: #fff8f7;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff0f0;
    surface-container: #ffe9e8;
    surface-container-high: #fee2e1;
    surface-container-highest: #f8dcdc;
}