* {
    primary: #d9c773;
    primary-fixed: #f7e38c;
    primary-fixed-alpha: rgba(247, 227, 140, 0.2);
    primary-fixed-dim: #d9c773;
    on-primary: #393000;
    on-primary-fixed: #211b00;
    on-primary-fixed-variant: #534600;
    primary-container: #ac9b4d;
    on-primary-container: #0f0b00;
    secondary: #d1c69f;
    secondary-fixed: #eee2b9;
    secondary-fixed-dim: #d1c69f;
    on-secondary: #363014;
    on-secondary-fixed: #211b03;
    on-secondary-fixed-variant: #4e4728;
    secondary-container: #4e4728;
    on-secondary-container: #ece0b7;
    tertiary: #afd190;
    tertiary-fixed: #cbeda9;
    tertiary-fixed-dim: #afd190;
    on-tertiary: #1d3706;
    on-tertiary-fixed: #0c2000;
    on-tertiary-fixed-variant: #334e1b;
    tertiary-container: #85a568;
    on-tertiary-container: #040f00;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #15130e;
    surface-alpha: rgba(21, 19, 14, 0.7);
    on-surface: #e7e2d8;
    on-surface-variant: #cdc6b4;
    outline: #969080;
    outline-variant: #4b4739;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e7e2d8;
    inverse-on-surface: #32302a;
    inverse-primary: #6c5e15;
    surface-dim: #15130e;
    surface-bright: #3b3932;
    surface-container-lowest: #100e09;
    surface-container-low: #1d1b16;
    surface-container: #21201a;
    surface-container-high: #2c2a24;
    surface-container-highest: #37352e;
}