* {
    primary: #006b5c;
    primary-fixed: #00fedd;
    primary-fixed-alpha: rgba(0, 254, 221, 0.2);
    primary-fixed-dim: #00dfc2;
    on-primary: #ffffff;
    on-primary-fixed: #00201b;
    on-primary-fixed-variant: #005045;
    primary-container: #00fedd;
    on-primary-container: #00201b;
    secondary: #386665;
    secondary-fixed: #bbecea;
    secondary-fixed-dim: #a0cfce;
    on-secondary: #ffffff;
    on-secondary-fixed: #002020;
    on-secondary-fixed-variant: #1e4e4d;
    secondary-container: #bbecea;
    on-secondary-container: #002020;
    tertiary: #1c6773;
    tertiary-fixed: #a9eefb;
    tertiary-fixed-dim: #8ed1de;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #001f24;
    on-tertiary-fixed-variant: #004f58;
    tertiary-container: #a9eefb;
    on-tertiary-container: #001f24;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #eefdf7;
    surface-alpha: rgba(238, 253, 247, 0.7);
    on-surface: #111e1b;
    on-surface-variant: #3c4946;
    outline: #6c7a76;
    outline-variant: #bbcac5;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #263330;
    inverse-on-surface: #e5f4ef;
    inverse-primary: #00dfc2;
    surface-dim: #cfddd8;
    surface-bright: #eefdf7;
    surface-container-lowest: #ffffff;
    surface-container-low: #e8f7f1;
    surface-container: #e3f1ec;
    surface-container-high: #ddebe6;
    surface-container-highest: #d7e6e0;
}