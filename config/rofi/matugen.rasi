* {
    primary: #815206;
    primary-fixed: #ffddb8;
    primary-fixed-alpha: rgba(255, 221, 184, 0.2);
    primary-fixed-dim: #fbba6a;
    on-primary: #ffffff;
    on-primary-fixed: #2a1700;
    on-primary-fixed-variant: #653e00;
    primary-container: #9e6a21;
    on-primary-container: #ffffff;
    secondary: #745a3a;
    secondary-fixed: #ffddb8;
    secondary-fixed-dim: #e3c19a;
    on-secondary: #ffffff;
    on-secondary-fixed: #2a1801;
    on-secondary-fixed-variant: #5a4225;
    secondary-container: #fedab2;
    on-secondary-container: #5a4225;
    tertiary: #586115;
    tertiary-fixed: #dfea8f;
    tertiary-fixed-dim: #c3cd76;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #1a1e00;
    on-tertiary-fixed-variant: #434b00;
    tertiary-container: #707a2d;
    on-tertiary-container: #ffffff;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f4;
    surface-alpha: rgba(255, 248, 244, 0.7);
    on-surface: #201b15;
    on-surface-variant: #514538;
    outline: #837566;
    outline-variant: #d5c4b3;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #352f29;
    inverse-on-surface: #fbefe5;
    inverse-primary: #fbba6a;
    surface-dim: #e3d8cf;
    surface-bright: #fff8f4;
    surface-container-lowest: #ffffff;
    surface-container-low: #fdf2e8;
    surface-container: #f8ece2;
    surface-container-high: #f2e6dd;
    surface-container-highest: #ece0d7;
}