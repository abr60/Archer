* {
    primary: #ffb5a0;
    primary-fixed: #ffdbd1;
    primary-fixed-alpha: rgba(255, 219, 209, 0.2);
    primary-fixed-dim: #ffb5a0;
    on-primary: #601500;
    on-primary-fixed: #3b0900;
    on-primary-fixed-variant: #872100;
    primary-container: #872100;
    on-primary-container: #ffdbd1;
    secondary: #f2bb99;
    secondary-fixed: #ffdbc7;
    secondary-fixed-dim: #f2bb99;
    on-secondary: #492810;
    on-secondary-fixed: #301401;
    on-secondary-fixed-variant: #643e24;
    secondary-container: #643e24;
    on-secondary-container: #ffdbc7;
    tertiary: #f4bc7c;
    tertiary-fixed: #ffddb9;
    tertiary-fixed-dim: #f4bc7c;
    on-tertiary: #472a00;
    on-tertiary-fixed: #2b1700;
    on-tertiary-fixed-variant: #643e08;
    tertiary-container: #643e08;
    on-tertiary-container: #ffddb9;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1e100c;
    surface-alpha: rgba(30, 16, 12, 0.7);
    on-surface: #f9dcd5;
    on-surface-variant: #dcc1ba;
    outline: #a38b85;
    outline-variant: #55423d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f9dcd5;
    inverse-on-surface: #3d2c28;
    inverse-primary: #b12e00;
    surface-dim: #1e100c;
    surface-bright: #473530;
    surface-container-lowest: #180b07;
    surface-container-low: #271814;
    surface-container: #2b1c18;
    surface-container-high: #372622;
    surface-container-highest: #42312c;
}