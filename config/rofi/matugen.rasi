* {
    primary: #695f12;
    primary-fixed: #f2e48a;
    primary-fixed-alpha: rgba(242, 228, 138, 0.2);
    primary-fixed-dim: #d5c871;
    on-primary: #ffffff;
    on-primary-fixed: #201c00;
    on-primary-fixed-variant: #4f4700;
    primary-container: #f2e48a;
    on-primary-container: #201c00;
    secondary: #645f41;
    secondary-fixed: #ebe3bd;
    secondary-fixed-dim: #cec7a2;
    on-secondary: #ffffff;
    on-secondary-fixed: #1f1c05;
    on-secondary-fixed-variant: #4c472b;
    secondary-container: #ebe3bd;
    on-secondary-container: #1f1c05;
    tertiary: #416652;
    tertiary-fixed: #c2ecd2;
    tertiary-fixed-dim: #a7d0b7;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #002113;
    on-tertiary-fixed-variant: #294e3b;
    tertiary-container: #c2ecd2;
    on-tertiary-container: #002113;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff9eb;
    surface-alpha: rgba(255, 249, 235, 0.7);
    on-surface: #1d1c13;
    on-surface-variant: #4a473a;
    outline: #7b7768;
    outline-variant: #ccc6b5;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #323027;
    inverse-on-surface: #f6f0e3;
    inverse-primary: #d5c871;
    surface-dim: #dfdacc;
    surface-bright: #fff9eb;
    surface-container-lowest: #ffffff;
    surface-container-low: #f9f3e5;
    surface-container: #f3eee0;
    surface-container-high: #ede8da;
    surface-container-highest: #e7e2d5;
}