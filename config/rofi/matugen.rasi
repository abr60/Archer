* {
    primary: #a2d0c5;
    primary-fixed: #beece1;
    primary-fixed-alpha: rgba(190, 236, 225, 0.2);
    primary-fixed-dim: #a2d0c5;
    on-primary: #063730;
    on-primary-fixed: #00201b;
    on-primary-fixed-variant: #234e46;
    primary-container: #01332c;
    on-primary-container: #95c2b8;
    secondary: #b8cac5;
    secondary-fixed: #d4e6e1;
    secondary-fixed-dim: #b8cac5;
    on-secondary: #243330;
    on-secondary-fixed: #0f1e1b;
    on-secondary-fixed-variant: #3a4a46;
    secondary-container: #3c4c48;
    on-secondary-container: #d6e8e2;
    tertiary: #f5b8ab;
    tertiary-fixed: #ffdad3;
    tertiary-fixed-dim: #f5b8ab;
    on-tertiary: #4c261e;
    on-tertiary-fixed: #32120b;
    on-tertiary-fixed-variant: #663b32;
    tertiary-container: #47221a;
    on-tertiary-container: #e6ab9f;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #111413;
    surface-alpha: rgba(17, 20, 19, 0.7);
    on-surface: #e2e3e1;
    on-surface-variant: #c0c8c5;
    outline: #8a9290;
    outline-variant: #404846;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e3e1;
    inverse-on-surface: #2f3130;
    inverse-primary: #3b665e;
    surface-dim: #111413;
    surface-bright: #373a39;
    surface-container-lowest: #0c0f0e;
    surface-container-low: #1a1c1b;
    surface-container: #1e201f;
    surface-container-high: #282a2a;
    surface-container-highest: #333534;
}