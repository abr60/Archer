* {
    primary: #a33e00;
    primary-fixed: #ffdbcd;
    primary-fixed-alpha: rgba(255, 219, 205, 0.2);
    primary-fixed-dim: #ffb596;
    on-primary: #ffffff;
    on-primary-fixed: #360f00;
    on-primary-fixed-variant: #7c2e00;
    primary-container: #ffdbcd;
    on-primary-container: #360f00;
    secondary: #7d5636;
    secondary-fixed: #ffdcc3;
    secondary-fixed-dim: #f0bc95;
    on-secondary: #ffffff;
    on-secondary-fixed: #2f1500;
    on-secondary-fixed-variant: #623f21;
    secondary-container: #ffdcc3;
    on-secondary-container: #2f1500;
    tertiary: #7e561d;
    tertiary-fixed: #ffddb6;
    tertiary-fixed-dim: #f2bd7a;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #2a1800;
    on-tertiary-fixed-variant: #633f06;
    tertiary-container: #ffddb6;
    on-tertiary-container: #2a1800;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f6;
    surface-alpha: rgba(255, 248, 246, 0.7);
    on-surface: #271812;
    on-surface-variant: #55433b;
    outline: #88726a;
    outline-variant: #dbc1b7;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #3d2d26;
    inverse-on-surface: #ffede7;
    inverse-primary: #ffb596;
    surface-dim: #f0d4ca;
    surface-bright: #fff8f6;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff1ec;
    surface-container: #ffe9e2;
    surface-container-high: #fee2d8;
    surface-container-highest: #f8ddd2;
}