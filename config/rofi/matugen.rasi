* {
    primary: #006973;
    primary-fixed: #9df0fc;
    primary-fixed-alpha: rgba(157, 240, 252, 0.2);
    primary-fixed-dim: #81d3df;
    on-primary: #ffffff;
    on-primary-fixed: #001f23;
    on-primary-fixed-variant: #004f57;
    primary-container: #9df0fc;
    on-primary-container: #001f23;
    secondary: #4a6366;
    secondary-fixed: #cde7eb;
    secondary-fixed-dim: #b1cbcf;
    on-secondary: #ffffff;
    on-secondary-fixed: #051f22;
    on-secondary-fixed-variant: #324b4e;
    secondary-container: #cde7eb;
    on-secondary-container: #051f22;
    tertiary: #515e7d;
    tertiary-fixed: #d9e2ff;
    tertiary-fixed-dim: #b9c6ea;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #0d1b37;
    on-tertiary-fixed-variant: #3a4664;
    tertiary-container: #d9e2ff;
    on-tertiary-container: #0d1b37;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f5fafb;
    surface-alpha: rgba(245, 250, 251, 0.7);
    on-surface: #171d1e;
    on-surface-variant: #3f484a;
    outline: #6f797a;
    outline-variant: #bec8ca;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2b3132;
    inverse-on-surface: #ecf2f3;
    inverse-primary: #81d3df;
    surface-dim: #d5dbdc;
    surface-bright: #f5fafb;
    surface-container-lowest: #ffffff;
    surface-container-low: #eff5f5;
    surface-container: #e9eff0;
    surface-container-high: #e3e9ea;
    surface-container-highest: #dee4e4;
}