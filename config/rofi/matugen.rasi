* {
    primary: #6c5e00;
    primary-fixed: #ffe338;
    primary-fixed-alpha: rgba(255, 227, 56, 0.2);
    primary-fixed-dim: #e1c712;
    on-primary: #ffffff;
    on-primary-fixed: #211c00;
    on-primary-fixed-variant: #514700;
    primary-container: #ddc30a;
    on-primary-container: #3c3400;
    secondary: #695f21;
    secondary-fixed: #f3e398;
    secondary-fixed-dim: #d6c77f;
    on-secondary: #ffffff;
    on-secondary-fixed: #211c00;
    on-secondary-fixed-variant: #51470a;
    secondary-container: #f0e095;
    on-secondary-container: #50460a;
    tertiary: #246293;
    tertiary-fixed: #cfe5ff;
    tertiary-fixed-dim: #98cbff;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #001d33;
    on-tertiary-fixed-variant: #004a77;
    tertiary-container: #91c8ff;
    on-tertiary-container: #003659;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff9ec;
    surface-alpha: rgba(255, 249, 236, 0.7);
    on-surface: #1e1c11;
    on-surface-variant: #4b4733;
    outline: #7d7760;
    outline-variant: #cec6ac;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #333025;
    inverse-on-surface: #f7f0df;
    inverse-primary: #e1c712;
    surface-dim: #e0dac9;
    surface-bright: #fff9ec;
    surface-container-lowest: #ffffff;
    surface-container-low: #faf3e1;
    surface-container: #f4eddc;
    surface-container-high: #eee8d6;
    surface-container-highest: #e9e2d1;
}