* {
    primary: #ffafd3;
    primary-fixed: #ffd8e7;
    primary-fixed-alpha: rgba(255, 216, 231, 0.2);
    primary-fixed-dim: #ffafd3;
    on-primary: #620040;
    on-primary-fixed: #3d0026;
    on-primary-fixed-variant: #8b005c;
    primary-container: #a2196e;
    on-primary-container: #fffbff;
    secondary: #ffafd3;
    secondary-fixed: #ffd8e7;
    secondary-fixed-dim: #ffafd3;
    on-secondary: #56193b;
    on-secondary-fixed: #3b0325;
    on-secondary-fixed-variant: #713052;
    secondary-container: #773557;
    on-secondary-container: #ffe0eb;
    tertiary: #ffb4a8;
    tertiary-fixed: #ffdad4;
    tertiary-fixed-dim: #ffb4a8;
    on-tertiary: #690000;
    on-tertiary-fixed: #410000;
    on-tertiary-fixed-variant: #8e120a;
    tertiary-container: #a62519;
    on-tertiary-container: #fffbff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1b1015;
    surface-alpha: rgba(27, 16, 21, 0.7);
    on-surface: #f3dde4;
    on-surface-variant: #dcbfca;
    outline: #a48a94;
    outline-variant: #56414a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f3dde4;
    inverse-on-surface: #3a2d32;
    inverse-primary: #ac2376;
    surface-dim: #1b1015;
    surface-bright: #43353b;
    surface-container-lowest: #150b10;
    surface-container-low: #24181d;
    surface-container: #281c21;
    surface-container-high: #33272c;
    surface-container-highest: #3e3136;
}