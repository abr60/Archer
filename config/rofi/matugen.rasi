* {
    primary: #d6c781;
    primary-fixed: #f3e39b;
    primary-fixed-alpha: rgba(243, 227, 155, 0.2);
    primary-fixed-dim: #d6c781;
    on-primary: #393000;
    on-primary-fixed: #211b00;
    on-primary-fixed-variant: #51470d;
    primary-container: #9e9151;
    on-primary-container: #000000;
    secondary: #d0c6a5;
    secondary-fixed: #ece2c0;
    secondary-fixed-dim: #d0c6a5;
    on-secondary: #353019;
    on-secondary-fixed: #201c06;
    on-secondary-fixed-variant: #4d472d;
    secondary-container: #4d472d;
    on-secondary-container: #eae0be;
    tertiary: #b1d09a;
    tertiary-fixed: #cdecb5;
    tertiary-fixed-dim: #b1d09a;
    on-tertiary: #1f3610;
    on-tertiary-fixed: #0a2100;
    on-tertiary-fixed-variant: #344d24;
    tertiary-container: #7d9968;
    on-tertiary-container: #000000;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #15130f;
    surface-alpha: rgba(21, 19, 15, 0.7);
    on-surface: #e7e2da;
    on-surface-variant: #ccc6b5;
    outline: #969081;
    outline-variant: #4a473a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e7e2da;
    inverse-on-surface: #32302b;
    inverse-primary: #6a5e24;
    surface-dim: #15130f;
    surface-bright: #3b3933;
    surface-container-lowest: #0f0e0a;
    surface-container-low: #1d1b17;
    surface-container: #21201b;
    surface-container-high: #2c2a25;
    surface-container-highest: #37352f;
}