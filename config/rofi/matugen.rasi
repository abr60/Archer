* {
    primary: #becf6c;
    primary-fixed: #daec85;
    primary-fixed-alpha: rgba(218, 236, 133, 0.2);
    primary-fixed-dim: #becf6c;
    on-primary: #2c3400;
    on-primary-fixed: #181e00;
    on-primary-fixed-variant: #404c00;
    primary-container: #89983c;
    on-primary-container: #000000;
    secondary: #c4cb9c;
    secondary-fixed: #e0e7b6;
    secondary-fixed-dim: #c4cb9c;
    on-secondary: #2d3311;
    on-secondary-fixed: #191e01;
    on-secondary-fixed-variant: #444a26;
    secondary-container: #464c28;
    on-secondary-container: #e1e8b7;
    tertiary: #8ad89b;
    tertiary-fixed: #a5f4b6;
    tertiary-fixed-dim: #8ad89b;
    on-tertiary: #003919;
    on-tertiary-fixed: #00210c;
    on-tertiary-fixed-variant: #005227;
    tertiary-container: #54a069;
    on-tertiary-container: #000000;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #13140d;
    surface-alpha: rgba(19, 20, 13, 0.7);
    on-surface: #e4e3d7;
    on-surface-variant: #c7c8b4;
    outline: #919280;
    outline-variant: #464839;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e4e3d7;
    inverse-on-surface: #303129;
    inverse-primary: #576509;
    surface-dim: #13140d;
    surface-bright: #393a32;
    surface-container-lowest: #0e0f08;
    surface-container-low: #1b1c15;
    surface-container: #1f2019;
    surface-container-high: #2a2b23;
    surface-container-highest: #35352e;
}