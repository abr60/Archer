* {
    primary: #ffffff;
    primary-fixed: #e3e3d9;
    primary-fixed-alpha: rgba(227, 227, 217, 0.2);
    primary-fixed-dim: #c7c7be;
    on-primary: #2f312b;
    on-primary-fixed: #1a1c16;
    on-primary-fixed-variant: #464740;
    primary-container: #e3e3d9;
    on-primary-container: #474942;
    secondary: #c8c6c2;
    secondary-fixed: #e4e2dd;
    secondary-fixed-dim: #c8c6c2;
    on-secondary: #30312d;
    on-secondary-fixed: #1b1c19;
    on-secondary-fixed-variant: #474743;
    secondary-container: #474743;
    on-secondary-container: #e2e0db;
    tertiary: #ffffff;
    tertiary-fixed: #ebdfe4;
    tertiary-fixed-dim: #cec4c8;
    on-tertiary: #352f32;
    on-tertiary-fixed: #1f1a1e;
    on-tertiary-fixed-variant: #4c4549;
    tertiary-container: #ebdfe4;
    on-tertiary-container: #4d464a;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #141313;
    surface-alpha: rgba(20, 19, 19, 0.7);
    on-surface: #e5e2e0;
    on-surface-variant: #c7c7bf;
    outline: #91918a;
    outline-variant: #464741;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e5e2e0;
    inverse-on-surface: #31302f;
    inverse-primary: #5e5f58;
    surface-dim: #141313;
    surface-bright: #3a3938;
    surface-container-lowest: #0e0e0d;
    surface-container-low: #1c1b1b;
    surface-container: #201f1f;
    surface-container-high: #2a2a29;
    surface-container-highest: #353534;
}