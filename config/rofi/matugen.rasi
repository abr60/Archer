* {
    primary: #a7d388;
    primary-fixed: #c3f0a2;
    primary-fixed-alpha: rgba(195, 240, 162, 0.2);
    primary-fixed-dim: #a7d388;
    on-primary: #153800;
    on-primary-fixed: #0a2100;
    on-primary-fixed-variant: #2b4f14;
    primary-container: #86b069;
    on-primary-container: #081e00;
    secondary: #bacca9;
    secondary-fixed: #d6e9c3;
    secondary-fixed-dim: #bacca9;
    on-secondary: #26351b;
    on-secondary-fixed: #111f08;
    on-secondary-fixed-variant: #3c4b30;
    secondary-container: #3e4e32;
    on-secondary-container: #d7eac5;
    tertiary: #78d7c2;
    tertiary-fixed: #94f4de;
    tertiary-fixed-dim: #78d7c2;
    on-tertiary: #00382f;
    on-tertiary-fixed: #00201a;
    on-tertiary-fixed-variant: #005144;
    tertiary-container: #53b4a0;
    on-tertiary-container: #001d18;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #12140f;
    surface-alpha: rgba(18, 20, 15, 0.7);
    on-surface: #e2e3da;
    on-surface-variant: #c3c9b9;
    outline: #8d9385;
    outline-variant: #43493d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e3da;
    inverse-on-surface: #2f312b;
    inverse-primary: #42682a;
    surface-dim: #12140f;
    surface-bright: #383a34;
    surface-container-lowest: #0c0f0a;
    surface-container-low: #1a1c17;
    surface-container: #1e201b;
    surface-container-high: #282b25;
    surface-container-highest: #333630;
}