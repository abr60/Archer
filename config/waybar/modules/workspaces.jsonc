{
"hyprland/workspaces": {
  //"persistent-workspaces": {"*": [ 1,2,3,4,5,6 ]},
	"on-click": "activate",
	"format": "{windows}", //{icon} 
  "enable-bar-scroll": true,
  "tooltip": false,
	"format-window-separator": " ",
	"window-rewrite-default": "",
