{
  "cpu": {
    "interval": 5,
    "format": " {usage}",
    "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

"memory": {
  "interval": 2,
  "format": " {used:0.1f}",
  "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
  "states": { "warning": 70, "critical": 90 },
  "tooltip": false
}, 

"temperature": {
  "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
  "format": "{temperatureC}°C",
  "format-critical": " {temperatureC}°C",
  "critical-threshold": 75,
  "interval": 5,
  "tooltip": false,
  "menu": "on-click",
  "menu-file": "$HOME/.config/waybar/menu/temp.xml",
  "menu-actions": {
    "fan_full": "bash -c 'echo \"level full-speed\" | sudo tee /proc/acpi/ibm/fan'",
    "fan_auto": "sudo systemctl restart thinkfan"
  }
},

  "backlight": {
    "device": "intel_backlight",
    "format": "",
    "min-length": 4,
    "tooltip": false,
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%",
    "on-click": "archer-set-mode $([ \"$(cat ~/.local/state/Archer/current-mode)\" = 'dark' ] && echo light || echo dark)"
  },

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
        "default": " ",
        "performance": " ",
        "balanced": " ",
        "power-saver": "󰌪 "
    }
},

"battery": {
  "format": "{capacity}",
  "format-charging": "{icon} {capacity}",
  "format-icons": { "charging": [""] },
  "format-full": "UNPLUG!",
  "states": { "warning": 20, "critical": 10 },
  "interval": 5,
  "on-click": "menu power"
},

  "custom/hdd": {
    "exec": "~/.config/hypr/scripts/hdd/hdd-status",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/hdd/hdd-unmount",
    "tooltip": true
  },

  "custom/expand-icon": {
    "format": "|",
    "tooltip": false
  },

  "tray": {
    "icon-size": 12,
    "spacing": 4,
    "show-passive-items": true
  }
}
