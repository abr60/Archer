{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 32,
  "width": 1280,
  "margin": "0px 6px 0px 6px",
  "spacing": 0,

  "modules-left": [
    "group/left-brand",
    "group/left-system",
    "group/left-media"
  ],

  "modules-center": [
    "group/center-status",
    "hyprland/workspaces",
    "group/center-storage"
  ],

  "modules-right": [
    "group/right-time",
    "group/right-power",
    "group/tray-expander",
    "group/right-hardware"
  ],

  // ────────────────────────────────────────────────
  // GROUPS
  // ────────────────────────────────────────────────

  "group/left-brand": {
    "orientation": "inherit"
    // "modules": ["custom/archer"] //"custom/active_window"]
  },

  "group/left-system": {
    "orientation": "inherit",
    "modules": ["custom/resources", "custom/mpris", "custom/weather",  "custom/updatespacman", "custom/timer"]
  },

  "group/left-media": {
    "orientation": "inherit",
    "modules": ["custom/screenrecording-indicator"]
  },

  "group/center-status": {
    "orientation": "inherit",
    "modules": ["custom/voxtype"]
  },

  "group/center-storage": {
    "orientation": "inherit",
    "modules": ["custom/hdd"]
  },

  "group/right-time": {
    "orientation": "inherit",
    "modules": ["battery", "custom/clock"]
  },

  "group/right-power": {
    "orientation": "inherit",
    "modules": []
  },

  "group/right-hardware": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio#microphone",
      "pulseaudio",
      "custom/swaync",
      "network",
      "bluetooth"
    ]
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "backlight",
      "temperature",
      "custom/menu"
    ]
  },

  // ────────────────────────────────────────────────
  // LEFT MODULES
  // ────────────────────────────────────────────────

  "custom/archer": {
    "format": "<span size='14500'></span>"
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/assets/scripts/window.sh",
    "return-type": "json",
    "markup": true,
    "tooltip": false
  },

  "custom/resources": {
    "exec": "~/.config/waybar/assets/scripts/resources.sh",
    "interval": 4,
    "return-type": "json",
    "format": "{}",
    "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
    "tooltip": true
  },

"custom/mpris": {
  "exec": "~/.config/waybar/assets/scripts/mpris.sh",
  "interval": 1,
  "return-type": "json",
  "on-click": "playerctl play-pause",
  "on-click-right": "timeout 60s kitty --class kitty --title rmpc -e rmpc",
  "on-scroll-up": "playerctl next",
  "on-scroll-down": "playerctl previous",
  "tooltip": false
},

  "custom/screenrecording-indicator": {
    "exec": "$ARCHER_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
    "on-click": "capture-screenrecording"
  },

    "custom/timer": {
    "exec": "~/.config/waybar/assets/scripts/timer",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/assets/scripts/timer click",
    "on-click-right": "~/.config/waybar/assets/scripts/timer right",
    "on-click-middle": "~/.config/waybar/assets/scripts/timer middle",
    "on-scroll-up": "~/.config/waybar/assets/scripts/timer down",
    "on-scroll-down": "~/.config/waybar/assets/scripts/timer up",
    "tooltip": true,
    "escape": true
  },


  // ────────────────────────────────────────────────
  // CENTER MODULES
  // ────────────────────────────────────────────────

  "hyprland/workspaces": {
	"on-click": "activate",
	"format": "{icon} {windows}",
  "enable-bar-scroll": true,
  "tooltip": false,
	"format-window-separator": " ",
	"window-rewrite-default": "",
	"window-rewrite": {		
        "class<.*imv*.>": "",
        "class<.*bambustudio*.>": "󰐫",
        "class<.*bitwarden*.>": "",
        "class<.*handbrake*.>": "󰈫",
        "class<.*stremio*.>": "󱖏",
        "title<.*waydroid*.>": "",
        "class<.*grayjay*.>": "󱗆",
		"title<.*amazon.*>": "",
		"class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "",
		"class<zen>": "󰰷",
		"class<waterfox|waterfox-bin>": "",
		"class<microsoft-edge>": "",
		"class<Chromium|Thorium|[Cc]hrome>": "",
		"class<brave-browser>": "🦁",
		"class<tor-browser>": "",
		"class<firefox-developer-edition>": "🦊",
		"class<kitty|konsole>": "",
		"class<kitty-dropterm>": "",
		"class<com.mitchellh.ghostty>": "",
		"class<org.wezfurlong.wezterm>": "",
        "class<org.omarchy.terminal>": "󰏖",
		"class<[Tt]hunderbird|[Tt]hunderbird-esr>": "",
		"class<eu.betterbird.Betterbird>": "",
		"title<.*gmail.*>": "󰊫",
		"class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
		"class<discord|[Ww]ebcord|Vesktop>": "",
		"title<.*whatsapp.*>": "",
    "title<.*zapzap.*>": "",
		"title<.*messenger.*>": "",
		"title<.*facebook.*>": " ",
		"title<.*reddit.*>": "",
		"title<.*ChatGPT.*>": "󰚩",
    "class<.*ChatGPT.*>": "󰚩",
		"title<.*deepseek.*>": "󰚩",
		"title<.*qwen.*>": "󰚩",
		"class<subl>": "󰅳",
		"class<slack>": "",
		"class<mpv>": "",
		"class<celluloid|Zoom>": "",
		"class<Cider>": "󰎆 ",
		"title<.*Picture-in-Picture.*>": "",
		"title<.*youtube.*>": "",
		"class<vlc>": "󰕼",
		"title<.*cmus.*>": "",
		"class<[Ss]potify>": "",
		"class<virt-macodeger>": "",
		"class<.virt-manager-wrapped>": "",
		"class<virtualbox manager>": "💽",
		"title<virtualbox>": "💽",
		"class<remmina>": "🖥️",
		"class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "󰨞",
    "class<dev.zed.Zed>": "󰵁",
		"class<codeblocks>": "󰅩",
		"title<.*github.*>": "",
		"class<mousepad>": "",
		"class<libreoffice-writer>": "",
		"class<libreoffice-startcenter>": " 󰏆",
		"class<libreoffice-calc>": "",
		"title<.*nvim ~.*>": "",
    "class<org.gnome.Nautilus>": "󰣆",
		"title<.*vim.*>": "",
		"title<.*figma.*>": "",
		"title<.*jira.*>": "",
		"class<jetbrains-idea>": "",
    "title<*.VSCode.*>": "󰨞",
    "class<.*code.*>": "󰨞",
		"class<obs|com.obsproject.Studio>": "",
		"class<polkit-gnome-authentication-agent-1>": "󰒃",
		"class<nwg-look>": "",
		"class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫",
		"class<steam>": "",
		"class<thunar|nemo>": "󰝰",	
    "class<Gparted>":"",
		"class<gimp>": "",
		"class<emulator>": "📱",
		"class<android-studio>": "",
   	"class<org.pipewire.Helvum>": "󰓃",
    "class<localsend>":"",
    "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛"
		}
	},

  "custom/voxtype": {
    "exec": "voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "voxtype-config",
    "on-click": "voxtype-model"
  },

  "custom/weather": {
    "format": "{}°",
    "exec": "wttrbar --nerd --location chittagong",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  "custom/updatespacman": {
    "format": "{} {icon}",
    "format-icons": { "has-updates": "", "updated": "" },
    "return-type": "json",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300",
    "on-click": "launch-floating-terminal-with-presentation update"
  },

  "custom/hdd": {
    "exec": "~/.config/hypr/scripts/hdd/hdd-status",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/hdd/hdd-unmount",
    "tooltip": true
  },

  // ────────────────────────────────────────────────
  // RIGHT MODULES
  // ────────────────────────────────────────────────

  "custom/expand-icon": {
    "format": "•",
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent} {icon}",
    "format-icons": ["🌑", "🌒", "🌓", "🌔", "🌕"],
    "min-length": 5,
    "tooltip": false
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
    "format": "{temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "critical-threshold": 75,
    "interval": 5,
    "tooltip": false
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} | {frequency}GHz | {signalStrength}%",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e impala"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e bluetui"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source --increase 5",
    "on-scroll-down": "pamixer --default-source --decrease 5",
    "scroll-step": 5,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "🔇 Muted",
    "format-icons": ["", "", ""],
    "max-volume": 130,
    "reverse-scrolling": 1,
    "on-click": "pamixer -t",
    "on-click-right": "timeout 15s launch-audio",
    "tooltip": false
  },

  "custom/clock": {
    "exec": "~/.config/waybar/assets/scripts/clock.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false
  },

  "battery": {
    "format": "{capacity}",
    "format-charging": "{icon} {capacity}",
    "format-icons": {
      "charging": [""],
      "format-full": "UNPLUG!"
    },
    "states": { "warning": 20, "critical": 10 },
    "interval": 5,
    "on-click": "menu power"
  },

  	"custom/swaync": {
		"tooltip": true,
		"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
		"format": "{icon} ",
		"format-icons": {
			"notification": "<span foreground='red'><sup></sup></span>",
			"none": "",
			"dnd-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-none": "",
			"inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},


  "custom/menu": {
    "format": "   ",
    "menu": "on-click",
    "tooltip": false,
    "menu-file": "$HOME/.config/waybar/assets/menu/menu.xml",
    "menu-actions": {
      "scheme_tonal_spot":  "archer-matugen-scheme --apply scheme-tonal-spot",
      "scheme_content":     "archer-matugen-scheme --apply scheme-content",
      "scheme_expressive":  "archer-matugen-scheme --apply scheme-expressive",
      "scheme_fidelity":    "archer-matugen-scheme --apply scheme-fidelity",
      "scheme_fruit_salad": "archer-matugen-scheme --apply scheme-fruit-salad",
      "scheme_monochrome":  "archer-matugen-scheme --apply scheme-monochrome",
      "scheme_neutral":     "archer-matugen-scheme --apply scheme-neutral",
      "scheme_rainbow":     "archer-matugen-scheme --apply scheme-rainbow",
      "scheme_vibrant":     "archer-matugen-scheme --apply scheme-vibrant",
      "anim_fast":   "ln -sf ~/.config/hypr/animations/fast.lua ~/.config/hypr/animations.lua && hyprctl reload",
      "anim_smooth": "ln -sf ~/.config/hypr/animations/fluid.lua ~/.config/hypr/animations.lua && hyprctl reload"
    }
  }
}