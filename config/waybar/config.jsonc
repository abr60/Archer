{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 32,
  "width": 1280,
  "margin": "0px 6px 0 6",
  "spacing": 0,

  "modules-left": [
    "custom/arch",
    "cpu",
    "memory",
    "mpris",
    "custom/timer",
    "custom/screenrecording-indicator"
  ],

  "modules-center": [
    //"custom/idle-indicator",
    "custom/voxtype",
    "custom/weather",
    "custom/cava",
    "clock",
    "custom/cava",
    "custom/updatespacman",
    "custom/hdd"
  ],

  "modules-right": [
    //"custom/cpucat",
    //"custom/mako-history",
    "group/tray-expander",
    "custom/wifi-qr",
    "network",
    "bluetooth",
    "pulseaudio#microphone",
    "pulseaudio",
    "battery",
    //"custom/exit"
    "custom/swaync"
  ],

  // ────────────────────────────────────────────────
  // LEFT MODULES
  // ────────────────────────────────────────────────

  "custom/arch": {
    "format": " ",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "{usage}% 󰍛",
    "on-click": "timeout 20s omarchy-launch-floating-terminal-with-presentation btop",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "memory": {
    "interval": 2,
    "format": "{used} GiB",
    "format-alt": "{used} / {total} GiB",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "mpris": {
    "format": "{player_icon}  {title}",
    "format-paused": "{status_icon} {title}",
    "interval": 1,
    "max-length": 35,
    "player-icons": {
      "default": "🎶",
      "mpd": "📻",
      "chromium": "",
      "spotify": "",
      "firefox": "",
      "mpv": "📺️"
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "default": ""
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },

"custom/timer": {
    "exec": "~/.config/waybar/assets/scripts/timer",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/assets/scripts/timer click",
    "on-click-right": "~/.config/waybar/assets/scripts/timer right",
    "on-click-middle": "~/.config/waybar/assets/scripts/timer middle",
    "on-scroll-up": "~/.config/waybar/assets/scripts/timer down",
    "on-scroll-down": "~/.config/waybar/assets/scripts/timer up",
    "tooltip": true,
    "escape": true
},

"custom/wifi-qr": {
    "format": "󰐲",
    "on-click": "hyprctl dispatch exec 'ghostty --class=wifi-qr --title=wifi-qr -e ~/.config/hypr/scripts/toolbox/wifi-qr'",
    "tooltip": "Scan to connect to Wi-Fi"
},

  "custom/screenrecording-indicator": {
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
    "on-click": "omarchy-capture-screenrecording"
  },

  // ────────────────────────────────────────────────
  // CENTER MODULES
  // ────────────────────────────────────────────────

  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model"
  },

  "custom/weather": {
    "format": "{}°",
    "exec": "wttrbar --nerd --location chittagong",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/assets/scripts/cava.py",
    "return-type": "json",
    "hide-empty-text": true
  },

  "clock": {
    "format": "{:L%A %I:%M %p}",
    "format-alt": "{:%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "on-click-right": "~/.local/share/omarchy/bin/omarchy-cmd-tzupdate"
  },

  "custom/updatespacman": {
    "format": "{} {icon}",
    "format-icons": { "has-updates": "👹", "updated": " " },
    "return-type": "json",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update"
  },

"custom/hdd": {
    "exec": "~/.config/hypr/scripts/hdd/hdd-status",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/hdd/hdd-unmount",
    "tooltip": true
},

  // ────────────────────────────────────────────────
  // RIGHT MODULES & GROUPS
  // ────────────────────────────────────────────────

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "backlight",
      "temperature"
      //"custom/dots-push"
    ]
  },

  "custom/expand-icon": {
    "format": "•",
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent} {icon}",
    "format-icons": ["🌑", "🌒", "🌓", "🌔", "🌕"],
    "min-length": 5,
    "tooltip": false
  },

  "custom/idle-indicator": {
    "on-click": "omarchy-toggle-idle",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/idle.sh",
    "signal": 9,
    "return-type": "json"
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
    "format": "{temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "critical-threshold": 75,
    "interval": 5,
    "tooltip": false
  },

  "custom/notification-silencing-indicator": {
    "on-click": "omarchy-toggle-notification-silencing",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/notification-silencing.sh",
    "signal": 10,
    "return-type": "json"
  },

  "tray": {
    "icon-size": 12,
    "spacing": 17
  },

"network": {
    "interval": 3,
    "format-wifi": "  {frequency}GHz | {signalStrength}%", //| {bandwidthTotalBytes}
    "format-ethernet": "{ifname} 󰀂",
    "format-disconnected": "󰖪 Damn!",
    "format-alt": "<span foreground='#88c0d0'> {bandwidthDownBytes:>8}</span> <span foreground='#d08770'> {bandwidthUpBytes:>8}</span>",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "Connected",
    "on-click": "mode", 
    "on-click-right": "timeout 15s omarchy-launch-wifi"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click-right": "rfkill toggle bluetooth",
    "on-click": "timeout 15s omarchy-launch-floating-terminal-with-presentation bluetui"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source --increase 5",
    "on-scroll-down": "pamixer --default-source --decrease 5",
    "scroll-step": 5,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}",
    "format-muted": "🚫Muted",
    "format-icons": ["", "", ""],
    "max-volume": 130,
    "reverse-scrolling": 1,
    "on-click": "pamixer -t",
    "on-click-right": "timeout 15s omarchy-launch-audio",
    "tooltip": false
  },

  "battery": {
    "format": "{capacity} {icon}",
    "format-charging": "{icon} {capacity}",
    "format-plugged": " {capacity}",
    "format-icons": {
      "charging": ["⚡"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "states": { "warning": 20, "critical": 10 },
    "interval": 5,
    "on-click": "omarchy-menu power"
  },

  "custom/exit": {
    "format": "",
    "on-click": "GSK_RENDERER=ngl omarchy-menu system",
    "tooltip": false
  },

  	"custom/swaync": {
		"tooltip": true,
		"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
		"format": "{icon} ",
		"format-icons": {
			"notification": "<span foreground='red'><sup></sup></span>",
			"none": "",
			"dnd-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-none": "",
			"inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},

  // ────────────────────────────────────────────────
  // UNUSED / EXTRA MODULES
  // ────────────────────────────────────────────────

  "custom/cpucat": {
    "format": "{}",
    "exec": "~/.config/waybar/assets/scripts/catloop"
  }
}
