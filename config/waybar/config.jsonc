{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "height": 22,
  "width": 1437,
  "margin": "0px 6px 0px 6px",
  "spacing": 0,

  "modules-left": [
    "group/left-1",
    "group/left-2"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "group/right-2",
    "group/right-1"
  ],

  // ────────────────────────────────────────────────
  // GROUPS
  // ────────────────────────────────────────────────

  "group/left-1": {
    "orientation": "inherit",
    "modules": ["custom/menu", "mpris", "temperature", "group/tray-expander"]
  },

  "group/left-2": {
    "orientation": "inherit",
    "modules": ["custom/weather", "custom/updatespacman", "custom/timer", "custom/hdd", "custom/screenrecording-indicator", "custom/voxtype", "tray"]
  },

  "group/right-1": {
    "orientation": "inherit",
    "modules": ["custom/notification-silencing-indicator", "bluetooth", "network", "backlight", "pulseaudio", "clock", "custom/power"]
  },

"group/right-2": {
    "orientation": "inherit",
    "modules": [
        "custom/vpn",
        "custom/idle-indicator",
        "custom/lens",
        "power-profiles-daemon",
        "battery"
    ]
},

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "pulseaudio#microphone",
      "cpu", "memory"
      
    ]
  },

  // ────────────────────────────────────────────────
  // LEFT MODULES
  // ────────────────────────────────────────────────

  "custom/archer": {
    "format": "<span size='14500'></span>"
  },

    "tray": {
    "icon-size": 12,
    "spacing": 4,
    "show-passive-items": true
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/assets/scripts/window.sh",
    "return-type": "json",
    "markup": true,
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": " {usage}",
    "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

"memory": {
  "interval": 2,
  "format": " {used:0.1f}",
  "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
  "states": { "warning": 70, "critical": 90 },
  "tooltip": false
}, 

"mpris": {
    "format": "{player_icon} ",
    "format-paused": "{player_icon} ",
    "interval": 1,
    "max-length": 35,
    "player-icons": {
      "default": "󰎆",
      "mpd": "󰎆",
      "chromium": "",
      "spotify": "",
      "firefox": "",
      "mpv": "",
      "vlc": "󰕼"
    },

    "on-click": "playerctl play-pause",
    "on-click-right": "timeout 60s kitty --class kitty --title rmpc -e rmpc",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",

    "tooltip": true,
    "tooltip-format": "App Target: {player}\nArtist: {artist}\nTitle: {title}\nAlbum: {album}\nStatus: {status}"
},


  "custom/screenrecording-indicator": {
    "on-click": "capture-screenrecording",
    "exec": "$ARCHER_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },

    "custom/notification-silencing-indicator": {
    "on-click": "toggle-notification-silencing",
    "exec": "$ARCHER_PATH/default/waybar/indicators/notification-silencing.sh",
    "signal": 10,
    "return-type": "json"
  },

    "custom/idle-indicator": {
    "on-click": "toggle-idle",
    "exec": "$ARCHER_PATH/default/waybar/indicators/idle.sh",
    "signal": 9,
    "return-type": "json"
  },

  "custom/timer": {
    "exec": "~/.config/waybar/assets/scripts/timer",
    "return-type": "json",
    "format": " {} ",
    "on-click": "~/.config/waybar/assets/scripts/timer click",
    "on-click-right": "~/.config/waybar/assets/scripts/timer right",
    "on-click-middle": "~/.config/waybar/assets/scripts/timer middle",
    "on-scroll-up": "~/.config/waybar/assets/scripts/timer down",
    "on-scroll-down": "~/.config/waybar/assets/scripts/timer up",
    "tooltip": true,
    "escape": true
  },

  // ────────────────────────────────────────────────
  // CENTER MODULES
  // ────────────────────────────────────────────────

  "hyprland/workspaces": {
  //"persistent-workspaces": {"*": [ 1,2,3,4,5,6 ]},
	"on-click": "activate",
	"format": "{windows}", //{icon} 
  "enable-bar-scroll": true,
  "tooltip": false,
	"format-window-separator": " ",
	"window-rewrite-default": "",
	"window-rewrite": {		
        "class<.*imv*.>": "",
        "class<.*bambustudio*.>": "󰐫",
        "class<.*bitwarden*.>": "",
        "class<.*handbrake*.>": "󰈫",
        "class<.*stremio*.>": "󱖏",
        "title<.*waydroid*.>": "",
        "class<.*grayjay*.>": "󱗆",
		"title<.*amazon.*>": "",
		"class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "",
		"class<zen>": "󰰷",
		"class<waterfox|waterfox-bin>": "",
		"class<microsoft-edge>": "",
		"class<Chromium|Thorium|[Cc]hrome>": "",
		"class<brave-browser>": "🦁",
		"class<tor-browser>": "",
		"class<firefox-developer-edition>": "🦊",
		"class<kitty|konsole>": "",
		"class<kitty-dropterm>": "",
		"class<com.mitchellh.ghostty>": "",
		"class<org.wezfurlong.wezterm>": "",
        "class<org.omarchy.terminal>": "󰏖",
		"class<[Tt]hunderbird|[Tt]hunderbird-esr>": "",
		"class<eu.betterbird.Betterbird>": "",
		"title<.*gmail.*>": "󰊫",
		"class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
		"class<discord|[Ww]ebcord|Vesktop>": "",
		"title<.*whatsapp.*>": "",
    "title<.*zapzap.*>": "",
		"title<.*messenger.*>": "",
		"title<.*facebook.*>": " ",
		"title<.*reddit.*>": "",
    "title<.*ChatGPT.*>": "",
    "class<.*ChatGPT.*>": "",
    "title<.*[Cc]laude.*>": "",
    "class<.*[Cc]laude.*>": "",
    "title<.*[Dd]eep[Ss]eek.*>": "󱢺",
    "class<.*[Dd]eep[Ss]eek.*>": "󱢺",
    "title<.*[Qq]wen.*>": "󰭆",
    "class<.*[Qq]wen.*>": "󰭆",
    "title<.*[Gg]emini.*>": "",
    "class<.*[Gg]emini.*>": "",
		"class<subl>": "󰅳",
		"class<slack>": "",
		"class<mpv>": "",
		"class<celluloid|Zoom>": "",
		"class<Cider>": "󰎆 ",
		"title<.*Picture-in-Picture.*>": "",
		"title<.*youtube.*>": "",
		"class<vlc>": "󰕼",
		"title<.*cmus.*>": "",
		"class<[Ss]potify>": "",
		"class<virt-macodeger>": "",
		"class<.virt-manager-wrapped>": "",
		"class<virtualbox manager>": "💽",
		"title<virtualbox>": "💽",
		"class<remmina>": "🖥️",
		"class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "󰨞",
    "class<dev.zed.Zed>": "󰵁",
		"class<codeblocks>": "󰅩",
		"title<.*github.*>": "",
		"class<mousepad>": "",
		"class<libreoffice-writer>": "",
		"class<libreoffice-startcenter>": " 󰏆",
		"class<libreoffice-calc>": "",
		"title<.*nvim ~.*>": "",
    "class<org.gnome.Nautilus>": "",
		"title<.*vim.*>": "",
		"title<.*figma.*>": "",
		"title<.*jira.*>": "",
		"class<jetbrains-idea>": "",
    "title<*.VSCode.*>": "󰨞",
    "class<.*code.*>": "󰨞",
		"class<obs|com.obsproject.Studio>": "",
		"class<polkit-gnome-authentication-agent-1>": "󰒃",
		"class<nwg-look>": "",
		"class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫",
		"class<steam>": "",
		"class<thunar|nemo>": "󰝰",	
    "class<Gparted>":"",
		"class<gimp>": "",
		"class<emulator>": "📱",
		"class<android-studio>": "",
   	"class<org.pipewire.Helvum>": "󰓃",
    "class<localsend>":"",
    "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛"
		}
	},

"custom/vpn": {
    "exec": "archer-vpn-status",
    "return-type": "json",
    "interval": "once",
    "signal": 12,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/assets/menu/vpn_menu.xml",
    "tooltip": true,
    "menu-actions": {
      "vpn_ca": "archer-vpn-toggle ca",
      "vpn_ch": "archer-vpn-toggle ch",
      "vpn_jp": "archer-vpn-toggle jp",
      "vpn_nl": "archer-vpn-toggle nl",
      "vpn_no": "archer-vpn-toggle no",
      "vpn_pl": "archer-vpn-toggle pl",
      "vpn_ro": "archer-vpn-toggle ro",
      "vpn_sg": "archer-vpn-toggle sg",
      "vpn_us": "archer-vpn-toggle us",
      "vpn_disconnect_all": "bash -c 'ACTIVE=$(cat /tmp/.archer-vpn-active 2>/dev/null); [[ -n $ACTIVE ]] && sudo wg-quick down $ACTIVE && rm -f /tmp/.archer-vpn-active && pkill -RTMIN+12 waybar && notify-send \"VPN\" \"Disconnected\"'",
      "vpn_ip_check":     "bash -c 'IP=$(curl -s --max-time 5 https://ipinfo.io); notify-send \"Public IP Info\" \"$IP\"'",
      "vpn_sync_configs": "archer-vpn-sync"
    }
},

  "custom/voxtype": {
    "exec": "archer-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰍬",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "archer-voxtype-config",
    "on-click": "archer-voxtype-model"
  },

  "custom/weather": {
    "format": " {}° ",
    "exec": "wttrbar --nerd --location chittagong",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  "custom/updatespacman": {
    "format": "{} {icon}",
    "format-icons": { "has-updates": "󰏗 ", "updated": " " },
    "return-type": "json",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300",
    "on-click": "launch-floating-terminal-with-presentation update"
  },

  "custom/hdd": {
    "exec": "~/.config/hypr/scripts/hdd/hdd-status",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/hdd/hdd-unmount",
    "tooltip": true
  },

  // ────────────────────────────────────────────────
  // RIGHT MODULES
  // ────────────────────────────────────────────────

  "custom/expand-icon": {
    "format": "|",
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "",
    "min-length": 4,
    "tooltip": false,
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%",
    "on-click": "archer-set-mode $([ \"$(cat ~/.local/state/Archer/current-mode)\" = 'dark' ] && echo light || echo dark)"
  },

"temperature": {
  "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
  "format": "{temperatureC}°C",
  "format-critical": " {temperatureC}°C",
  "critical-threshold": 75,
  "interval": 5,
  "tooltip": false,
  "menu": "on-click",
  "menu-file": "$HOME/.config/waybar/assets/menu/temp.xml",
  "menu-actions": {
    "fan_full": "bash -c 'echo \"level full-speed\" | sudo tee /proc/acpi/ibm/fan'",
    "fan_auto": "sudo systemctl restart thinkfan"
  }
},

"network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} | {frequency}GHz | {signalStrength}%",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e impala",
    "on-click-right": "mode",
    "menu": "on-click-right",
    "menu-file": "$HOME/.config/waybar/assets/menu/vpn.xml",
    "menu-actions": {
      "vpn_connect": "pkexec wg-quick up wg0",
      "vpn_disconnect": "pkexec wg-quick down wg0",
      "vpn_status": "kitty --class kitty --title dropdown -e sh -c 'sudo wg; read -p \"Press enter to exit...\"'",
      "vpn_ip_check": "kitty --class kitty --title dropdown -e sh -c 'curl https://ipinfo.io; read -p \"\nPress enter to exit...\"'"
    }
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e bluetui",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "  {volume}",
    "format-source-muted": " 🚫 {volume}",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source --increase 5",
    "on-scroll-down": "pamixer --default-source --decrease 5",
    "scroll-step": 5,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "🔇 {volume}",
    "format-icons": [""],
    "max-volume": 125,
    "scrolling": 10,
    "on-click": "pamixer -t",
    "on-click-right": "timeout 15s launch-audio",
    "tooltip": false
  },

"clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A, %d/%m}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "month",
        "on-scroll": 1,
        "format": {
            "months":   "<span color='#ffead3'><b>{}</b></span>",
            "days":     "<span color='#ecc6d9'><b>{}</b></span>",
            "weeks":    "<span color='#99ffdd'><b>W{}</b></span>",
            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
            "today":    "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
    },
    "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    }
},

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
        "default": " ",
        "performance": " ",
        "balanced": " ",
        "power-saver": "󰌪 "
    }
},

"battery": {
  "format": "{capacity}",
  "format-charging": "{icon} {capacity}",
  "format-icons": { "charging": [""] },
  "format-full": "UNPLUG!",
  "states": { "warning": 20, "critical": 10 },
  "interval": 5,
  "on-click": "menu power"
},

"custom/lens": {
  "format": "<span size='16000'>󰧶 </span>",
  "on-click": "google-lens-capture",
  "tooltip": false
},

  	"custom/swaync": {
		"tooltip": false,
		"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
		"format": " {icon} ",
		"format-icons": {
			"notification": "<span foreground='red'><sup></sup></span>",
			"none": "",
			"dnd-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-none": "",
			"inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},

  "custom/power": {
	"format" : "⏻ ",
	"tooltip": false,
	"menu": "on-click",
	"menu-file": "~/.config/waybar/assets/menu/power-menu.xml",
	"menu-actions": {
		"shutdown": "shutdown",
		"reboot": "reboot",
		"suspend": "systemctl suspend",
		"hibernate": "systemctl hibernate"
	}
},

// ── Replace your existing "custom/menu" block in config.jsonc with this ──────

  "custom/menu": {
    "format": "   ",
    "menu": "on-click",
    "tooltip": false,
    "menu-file": "$HOME/.config/waybar/assets/menu/menu.xml",
    "menu-actions": {

      // ── Appearance ──────────────────────────────────────────────────────────
      "mode_dark":  "archer-set-mode dark",
      "mode_light": "archer-set-mode light",

      // ── Color Palette ───────────────────────────────────────────────────────
      "scheme_tonal_spot":  "archer-matugen-scheme --apply scheme-tonal-spot",
      "scheme_content":     "archer-matugen-scheme --apply scheme-content",
      "scheme_expressive":  "archer-matugen-scheme --apply scheme-expressive",
      "scheme_fidelity":    "archer-matugen-scheme --apply scheme-fidelity",
      "scheme_fruit_salad": "archer-matugen-scheme --apply scheme-fruit-salad",
      "scheme_monochrome":  "archer-matugen-scheme --apply scheme-monochrome",
      "scheme_neutral":     "archer-matugen-scheme --apply scheme-neutral",
      "scheme_rainbow":     "archer-matugen-scheme --apply scheme-rainbow",
      "scheme_vibrant":     "archer-matugen-scheme --apply scheme-vibrant",

      // ── Themes (these IDs are generated by generate-menu.sh, add yours here)
      // Pattern: "theme_<lowercased_dirname>": "rofi-set-theme-apply <ThemeName>"
      // For now, example entries — generate-menu.sh builds the XML side,
      // but config.jsonc actions must match the generated IDs manually or via
      // the archer-apply-theme wrapper below:
      "theme_canvas":      "archer-apply-theme Canvas",
      "theme_emerald":     "archer-apply-theme Emerald",
      "theme_graffiti":    "archer-apply-theme Graffiti",
      "theme_landscape":   "archer-apply-theme Landscape",
      "theme_monochrome":  "archer-apply-theme Monochrome",
      "theme_pixelpulse":  "archer-apply-theme Pixelpulse",
      "theme_spectrum":    "archer-apply-theme Spectrum",
      "theme_sumie":       "archer-apply-theme Sumi-e",

      // ── Wallpaper ───────────────────────────────────────────────────────────
      "wallpaper_select": "rofi-set-bg",
      "wallpaper_next":   "archer-wallpaper-cycle next",
      "wallpaper_prev":   "archer-wallpaper-cycle prev",
      "wallpaper_random": "archer-wallpaper-cycle random",

      // ── Animations (generated IDs match lua filenames, add more as needed) ──
      "anim_fast":   "ln -sf ~/.config/hypr/animations/fast.lua ~/.config/hypr/animations.lua && hyprctl reload",
      "anim_fluid":  "ln -sf ~/.config/hypr/animations/fluid.lua ~/.config/hypr/animations.lua && hyprctl reload",

      // ── Waybar Style (generated IDs match CSS filenames) ────────────────────
      "waybar_style_intricate": "ln -sf ~/.config/waybar/css/Intricate.css ~/.config/waybar/style.css && pkill -SIGUSR2 waybar",
      "waybar_style_pristine":  "ln -sf ~/.config/waybar/css/Pristine.css ~/.config/waybar/style.css && pkill -SIGUSR2 waybar",
      "waybar_style_omarchy":   "ln -sf ~/.config/waybar/css/omarchy.css ~/.config/waybar/style.css && pkill -SIGUSR2 waybar",
      "waybar_style_ii":        "ln -sf ~/.config/waybar/css/ii.css ~/.config/waybar/style.css && pkill -SIGUSR2 waybar",

      // ── Rescan ──────────────────────────────────────────────────────────────
      "rescan_menu": "generate-menu && pkill -SIGUSR2 waybar"
    }
  }
}
