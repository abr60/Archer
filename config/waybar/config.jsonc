{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 32,
  "width": 1280,
  "margin": "0px 6px 0 6",
  "spacing": 0,

  "modules-left": [
    "cpu",
    "memory",
    "mpris",
    "custom/timer",
    "custom/screenrecording-indicator"
  ],

  "modules-center": [
    "custom/voxtype",
    "custom/weather",
    "clock",
    "custom/updatespacman",
  //"custom/mode",
    "custom/hdd"
  ],

  "modules-right": [
    "group/tray-expander",
    //"custom/wifi-qr",
    "network",
    "bluetooth",
    "pulseaudio#microphone",
    "pulseaudio",
    "battery",
    "custom/swaync",
    "custom/menu"
  ],

  // ────────────────────────────────────────────────
  // LEFT MODULES
  // ────────────────────────────────────────────────
 
  "cpu": {
    "interval": 5,
    "format": "{usage}% 󰍛",
    "on-click": "timeout 20s launch-floating-terminal-with-presentation btop",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "memory": {
    "interval": 2,
    "format": "{used} GiB",
    "format-alt": "{used} / {total} GiB",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "mpris": {
    "format": "{player_icon}  {title}",
    "format-paused": "{status_icon} {title}",
    "interval": 1,
    "max-length": 35,
    "player-icons": {
      "default": "",
      "mpd": "󰐹",
      "chromium": "",
      "spotify": "",
      "firefox": "",
      "mpv": "󰎁"
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "default": ""
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "timeout 60s kitty --class kitty --title rmpc -e rmpc",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },

  "custom/timer": {
    "exec": "~/.config/waybar/assets/scripts/timer",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/assets/scripts/timer click",
    "on-click-right": "~/.config/waybar/assets/scripts/timer right",
    "on-click-middle": "~/.config/waybar/assets/scripts/timer middle",
    "on-scroll-up": "~/.config/waybar/assets/scripts/timer down",
    "on-scroll-down": "~/.config/waybar/assets/scripts/timer up",
    "tooltip": true,
    "escape": true
  },

  "custom/screenrecording-indicator": {
    "exec": "$ARCHER_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
    "on-click": "capture-screenrecording"
  },

  // ────────────────────────────────────────────────
  // CENTER MODULES
  // ────────────────────────────────────────────────

  "custom/voxtype": {
    "exec": "voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "voxtype-config",
    "on-click": "voxtype-model"
  },

  "custom/weather": {
    "format": "{}°",
    "exec": "wttrbar --nerd --location chittagong",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  "clock": {
    "format": "{:L%A %I:%M %p}",
    "format-alt": "{:%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "on-click-right": "~/.local/share/Archer/bin/cmd-tzupdate"
  },

  "custom/updatespacman": {
    "format": "{} {icon}",
    "format-icons": { "has-updates": "👹", "updated": " " },
    "return-type": "json",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300",
    "on-click": "launch-floating-terminal-with-presentation update"
  },

  "custom/mode": {
    "exec": "cat ~/.local/state/Archer/current-mode-icon 2>/dev/null || echo '󰖔'",
    "interval": 1,
    "signal": 1, 
    "format": "{}",
    "on-click": "archer-set-mode $([ \"$(cat ~/.local/state/Archer/current-mode)\" = 'dark' ] && echo light || echo dark) && pkill -SIGRTMIN+1 waybar",
    "tooltip": false
},

  "custom/hdd": {
    "exec": "~/.config/hypr/scripts/hdd/hdd-status",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/hdd/hdd-unmount",
    "tooltip": true
  },

  // ────────────────────────────────────────────────
  // RIGHT MODULES & GROUPS
  // ────────────────────────────────────────────────

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "backlight",
      "temperature"
    
    //"custom/omabat"
]
  },

  "custom/expand-icon": {
    "format": "•",
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent} {icon}",
    "format-icons": ["🌑", "🌒", "🌓", "🌔", "🌕"],
    "min-length": 5,
    "tooltip": false
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
    "format": "{temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "critical-threshold": 75,
    "interval": 5,
    "tooltip": false
  },

  "custom/wifi-qr": {
    "format": "󰐲",
    "on-click": "hyprctl dispatch exec 'ghostty --class=wifi-qr --title=wifi-qr -e archer-wifi-qr'",
    "tooltip": "Scan to connect to Wi-Fi"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}  {frequency}GHz | {signalStrength}%",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "<span foreground='#88c0d0'> {bandwidthDownBytes:>8}</span> <span foreground='#d08770'> {bandwidthUpBytes:>8}</span>",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e impala"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias}",
    //"on-click-right": "rfkill toggle bluetooth",
    "on-click": "timeout 40s kitty --class kitty --title dropdown -e bluetui"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source --increase 5",
    "on-scroll-down": "pamixer --default-source --decrease 5",
    "scroll-step": 5,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}",
    "format-muted": "🚫Muted",
    "format-icons": ["", "", ""],
    "max-volume": 130,
    "reverse-scrolling": 1,
    "on-click": "pamixer -t",
    "on-click-right": "timeout 15s launch-audio",
    "tooltip": false
  },

  "custom/omabat": {
    "exec": "'/home/pseudo/.local/bin/omabat' waybar",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "omarchy-launch-or-focus-tui '/home/pseudo/.local/bin/omabat'"
  },
  "battery": {
    "format": "{capacity} {icon}",
    "format-charging": "{icon} {capacity}",
    "format-plugged": " {capacity}",
    "format-icons": {
      "charging": ["⚡"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "states": { "warning": 20, "critical": 10 },
    "interval": 5,
    "on-click": "menu power"
  },

  	"custom/swaync": {
		"tooltip": true,
		"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
		"format": "{icon} ",
		"format-icons": {
			"notification": "<span foreground='red'><sup></sup></span>",
			"none": "",
			"dnd-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-none": "",
			"inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},

// ─── Add to your Waybar modules ───────────────────────────────────────────────
// Place the module wherever you want in your bar config, e.g. "modules-right"

"custom/menu": {
    "format": " ",
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/assets/menu/menu.xml",
    "menu-actions": {
        "scheme_tonal_spot":  "archer-matugen-scheme --apply scheme-tonal-spot",
        "scheme_content":     "archer-matugen-scheme --apply scheme-content",
        "scheme_expressive":  "archer-matugen-scheme --apply scheme-expressive",
        "scheme_fidelity":    "archer-matugen-scheme --apply scheme-fidelity",
        "scheme_fruit_salad": "archer-matugen-scheme --apply scheme-fruit-salad",
        "scheme_monochrome":  "archer-matugen-scheme --apply scheme-monochrome",
        "scheme_neutral":     "archer-matugen-scheme --apply scheme-neutral",
        "scheme_rainbow":     "archer-matugen-scheme --apply scheme-rainbow",
        "scheme_vibrant":     "archer-matugen-scheme --apply scheme-vibrant",

        // ── Stubbed — wire these when animation profiles are ready ──
        "anim_fast":   "ln -sf ~/.config/hypr/animations/fast.lua ~/.config/hypr/animations.lua && hyprctl reload",
        "anim_smooth": "ln -sf ~/.config/hypr/animations/fluid.lua ~/.config/hypr/animations.lua && hyprctl reload"
    }
}

}
