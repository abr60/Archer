#!/usr/bin/env bash
# =============================================================================
# rofi-set-theme — Pick a theme, automatically detect the current system mode,
#                  apply a random wallpaper, and trigger the color pipeline.
# =============================================================================

set -uo pipefail

if pidof rofi &>/dev/null; then
    killall rofi
    exit 0
fi

THEMES_DIR="$HOME/.local/share/Archer/Themes"
STATE_DIR="$HOME/.local/state/Archer"
THEME_FILE="$STATE_DIR/current-theme"
MODE_FILE="$STATE_DIR/current-mode"
SCRIPTS_DIR="$HOME/.config/matugen/bin"

# Cache Configuration matching the wallpaper picker pipeline
CACHE_DIR="$HOME/.cache/archer/theme-thumbs"
THUMB_SIZE="500"

if [[ ! -d "$THEMES_DIR" ]]; then
    notify-send "Archer" "Themes directory not found at $THEMES_DIR"
    exit 1
fi

# ─── Find themes ──────────────────────────────────────────────────────────────
mapfile -t THEMES < <(
    find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d \
    | sort \
    | xargs -I{} basename {}
)

if [[ ${#THEMES[@]} -eq 0 ]]; then
    notify-send "Archer" "No themes found in $THEMES_DIR"
    exit 1
fi

CURRENT=$(cat "$THEME_FILE" 2>/dev/null || echo "")

# ─── Theme Thumbnail Generation Function ──────────────────────────────────────
# Caches a square crop using integrity hashes to check for modifications
build_theme_thumb() {
    local theme_name="$1"
    local raw_img="$2"
    local thumb="$CACHE_DIR/${theme_name}.sqre.png"
    local hash_file="$CACHE_DIR/.${theme_name}.xxh"
    local lock_file="$CACHE_DIR/.lock_${theme_name}"
    local current_hash

    if command -v xxh64sum &>/dev/null; then
        current_hash=$(xxh64sum "$raw_img" | cut -d' ' -f1)
    else
        current_hash=$(md5sum "$raw_img" | cut -d' ' -f1)
    fi

    (
        flock -x 200
        if [[ ! -f "$thumb" ]] || \
           [[ ! -f "$hash_file" ]] || \
           [[ "$current_hash" != "$(cat "$hash_file" 2>/dev/null)" ]]; then 
            ffmpeg -y -i "$raw_img" \
                -vf "select=eq(n\,0),scale=${THUMB_SIZE}:${THUMB_SIZE}:force_original_aspect_ratio=increase,crop=${THUMB_SIZE}:${THUMB_SIZE}" \
                -vframes 1 "$thumb" >/dev/null 2>&1 && \
            echo "$current_hash" > "$hash_file"
        fi
        rm -f "$lock_file"
    ) 200>"$lock_file"
}

# ─── Process Theme Previews and Build Rofi Entries ────────────────────────────
mkdir -p "$CACHE_DIR"
rm -f "$CACHE_DIR"/.lock_* 2>/dev/null || true

entries=""
for theme_name in "${THEMES[@]}"; do
    # Find the source image inside the theme directory
    showcase_img=$(find -L "$THEMES_DIR/$theme_name" -maxdepth 1 -type f \
        \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \) \
        | sort | head -n 1)
    
    if [[ -n "$showcase_img" && -f "$showcase_img" ]]; then
        # Generate or check cached thumbnail
        build_theme_thumb "$theme_name" "$showcase_img"
        final_icon="$CACHE_DIR/${theme_name}.sqre.png"
    else
        final_icon="preferences-desktop-theme"
    fi
    
    # ─── State Check Added Here ──────────────────────────────────────────────
    # Appends the active meta property if the row matches your current theme file state
    if [[ "$theme_name" == "$CURRENT" ]]; then
        entries+="${theme_name}\0icon\x1f${final_icon}\x1factive\x1ftrue\n"
    else
        entries+="${theme_name}\0icon\x1f${final_icon}\n"
    fi
done

rm -f "$CACHE_DIR"/.lock_* 2>/dev/null || true

# ─── Pick theme via rofi ──────────────────────────────────────────────────────
SELECTED_THEME=$(echo -en "$entries" | rofi -dmenu -i -show-icons -no-custom \
    -p "Select Theme" \
    -theme "$HOME/.config/rofi/set-theme.rasi" \
    -select "$CURRENT")

[[ -z "$SELECTED_THEME" ]] && exit 0

if [[ ! -d "$THEMES_DIR/$SELECTED_THEME" ]]; then
    notify-send "Archer" "Theme '$SELECTED_THEME' not found"
    exit 1
fi

# ─── Auto-detect active system mode ───────────────────────────────────────────
MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "dark")

# ─── Save theme state ─────────────────────────────────────────────────────────
mkdir -p "$STATE_DIR"
echo "$SELECTED_THEME" > "$THEME_FILE"

# ─── Pick random wallpaper from selected theme ────────────────────────────────
BG_DIR="$THEMES_DIR/$SELECTED_THEME/Walls"

mapfile -t WALLS < <(
    find -L "$BG_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \
       -o -iname "*.webp" -o -iname "*.gif" \) | sort
)

if [[ ${#WALLS[@]} -eq 0 ]]; then
    notify-send "Archer" "No wallpapers found in '$SELECTED_THEME'"
    exit 1
fi

RANDOM_WALL="${WALLS[$RANDOM % ${#WALLS[@]}]}"
ln -nsf "$RANDOM_WALL" "$STATE_DIR/current-wallpaper"

# ─── Apply via awww ───────────────────────────────────────────────────────────
if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    uwsm-app -- awww-daemon &
    sleep 0.3
fi

setsid uwsm-app -- awww img "$STATE_DIR/current-wallpaper" \
    --transition-type grow \
    --transition-pos "$(hyprctl cursorpos | grep -E '^[0-9]' || echo '0,0')" \
    --transition-fps 60 \
    --transition-duration 0.8 \
    --resize crop &
disown

# ─── Delegate color/theme pipeline to archer-set-mode ─────────────────────────
"$SCRIPTS_DIR/archer-set-mode" "$MODE"