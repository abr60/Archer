#!/usr/bin/env bash
# =============================================================================
# gtk-theme-reload.sh — matugen post_hook for gtk3 + gtk4 templates
#
# Called TWICE per matugen run:
#   gtk3 template → no args        (just trigger adw-gtk3 reload)
#   gtk4 template → "$1"=image "$2"=mode  (also update icon theme + nautilus)
# =============================================================================

set -uo pipefail

STATE_DIR="$HOME/.local/state/Archer"
CURRENT_WP_LINK="$STATE_DIR/current-wallpaper"

wallpaper_path="${1:-}"
MODE="${2:-}"

# Detect current mode dynamically if not passed as an argument
[[ -z "$MODE" ]] && MODE="$(cat "$STATE_DIR/current-mode" 2>/dev/null || echo dark)"
[[ -z "$wallpaper_path" ]] && wallpaper_path="$(readlink -f "$CURRENT_WP_LINK" 2>/dev/null || echo "")"

# ─── adw-gtk3 reload trick (toggle off/on forces GTK3 apps to re-read colors) ──
gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-${MODE}" 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme "" 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-${MODE}" 2>/dev/null

# ─── gtk3 invocation has no args — stop here, gtk4 call handles the rest ───────
if [[ -z "${1:-}" ]]; then
    exit 0
fi

# ─── Yaru icon theme from dominant wallpaper color ─────────────────────────────
YARU_COLOR="Yaru-sage"  # fallback if detection fails

IM_CMD=$(command -v magick || command -v convert || true)

if [[ -n "$IM_CMD" && -f "$wallpaper_path" ]]; then
    if [[ "$MODE" == "light" ]]; then
        MIN_LUM=80; MAX_LUM=200; MIN_CHROMA=50
    else
        MIN_LUM=25; MAX_LUM=230; MIN_CHROMA=30
    fi

    DOMINANT=""
    while read -r hex; do
        [[ -z "$hex" ]] && continue
        r=$((16#${hex:1:2})); g=$((16#${hex:3:2})); b=$((16#${hex:5:2}))
        lum=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
        max_c=$(( r > g ? r : g )); max_c=$(( max_c > b ? max_c : b ))
        min_c=$(( r < g ? r : g )); min_c=$(( min_c < b ? min_c : b ))
        chroma=$(( max_c - min_c ))
        if (( lum >= MIN_LUM && lum <= MAX_LUM && chroma >= MIN_CHROMA )); then
            DOMINANT="$hex"
            break
        fi
    done < <(
        "$IM_CMD" "$wallpaper_path" -resize 100x100! -quantize transparent \
            +dither -colors 8 -format "%c" histogram:info:- 2>/dev/null \
        | sort -rn | grep -oP '#[0-9A-Fa-f]{6}'
    )

    if [[ -n "$DOMINANT" ]]; then
        r=$((16#${DOMINANT:1:2})); g=$((16#${DOMINANT:3:2})); b=$((16#${DOMINANT:5:2}))
        max_c=$(( r > g ? r : g )); max_c=$(( max_c > b ? max_c : b ))
        min_c=$(( r < g ? r : g )); min_c=$(( min_c < b ? min_c : b ))
        chroma=$(( max_c - min_c ))

        if (( chroma == 0 )); then
            hue=0
        elif (( max_c == r )); then
            hue=$(( (60 * (g - b) / chroma + 360) % 360 ))
        elif (( max_c == g )); then
            hue=$(( 60 * (b - r) / chroma + 120 ))
        else
            hue=$(( 60 * (r - g) / chroma + 240 ))
        fi

        if   (( hue >= 345 || hue < 15  )); then YARU_COLOR="Yaru-red"
        elif (( hue >= 15  && hue < 45  )); then YARU_COLOR="Yaru-wartybrown"
        elif (( hue >= 45  && hue < 75  )); then YARU_COLOR="Yaru-yellow"
        elif (( hue >= 75  && hue < 105 )); then YARU_COLOR="Yaru-olive"
        elif (( hue >= 105 && hue < 150 )); then YARU_COLOR="Yaru-sage"
        elif (( hue >= 150 && hue < 195 )); then YARU_COLOR="Yaru-prussiangreen"
        elif (( hue >= 195 && hue < 255 )); then YARU_COLOR="Yaru-blue"
        elif (( hue >= 255 && hue < 300 )); then YARU_COLOR="Yaru-purple"
        elif (( hue >= 300 && hue < 345 )); then YARU_COLOR="Yaru-magenta"
        fi
    fi
fi

[[ "$MODE" == "dark" ]] && ICON_THEME="${YARU_COLOR}-dark" || ICON_THEME="$YARU_COLOR"
gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" 2>/dev/null

# ─── Final D-Bus Kick-start for GTK4/Libadwaita apps (Nautilus) ──────────────
# We invert the mode for 50ms to force a genuine GSettings state mutation.
# This replicates the exact behavior that makes archer-set-mode work.

if [[ "$MODE" == "dark" ]]; then
    OPPOSITE="light"
else
    OPPOSITE="dark"
fi

# 1. Force state mutation to the opposite mode
gsettings set org.gnome.desktop.interface color-scheme "prefer-${OPPOSITE}" 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-${OPPOSITE}" 2>/dev/null

sleep 0.01  # Tiny window to ensure the D-Bus display server registers the shift

# 2. Re-apply the target mode with the fresh Matugen colors
gsettings set org.gnome.desktop.interface color-scheme "prefer-${MODE}" 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-${MODE}" 2>/dev/null