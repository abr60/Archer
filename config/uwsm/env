# Changes require a restart to take effect.

# Ensure Archer bins are in the path
export Archer_PATH=$HOME/.local/share/Archer
export PATH=$Archer_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
Archer-cmd-present mise && eval "$(mise activate bash --shims)"
