[Plymouth Theme]
Name=Archer
Description=Archer boot splash — ASCII art philosopher portrait with minimal LUKS prompt.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/archer
ScriptFile=/usr/share/plymouth/themes/archer/archer.script
ConsoleLogBackgroundColor=0x051305
MonospaceFont=Liberation Mono 12
Font=Liberation Mono 12
