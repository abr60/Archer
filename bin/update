#!/bin/bash
# archer:summary=Update Archer and system packages
# archer:args=[-y]
# archer:examples=update | update -y
# archer:requires-sudo=true

set -e

# Run inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $ARCHER_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env ARCHER_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/archer-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry.\n\nLog saved to /tmp/archer-update.log\033[0m"' ERR

if [[ $1 == "-y" ]] || update-confirm; then
  update-perform
fi
