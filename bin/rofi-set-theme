#!/usr/bin/env bash
# =============================================================================
# rofi-set-theme — Pick wallpaper collection + mode, apply random wallpaper,
#                  then delegate all color/theme work to archer-set-mode.
#
# State files:
#   ~/.local/state/Archer/current-collection  ← active collection name
#   ~/.local/state/Archer/current-wallpaper   ← symlink to active wallpaper
#   ~/.local/state/Archer/current-mode        ← "light" or "dark"
# =============================================================================

set -uo pipefail

if pidof rofi &>/dev/null; then
    killall rofi
    exit 0
fi

WALLPAPERS_DIR="$HOME/Wallpapers"
STATE_DIR="$HOME/.local/state/Archer"
COLLECTION_FILE="$STATE_DIR/current-collection"
MODE_FILE="$STATE_DIR/current-mode"
SCRIPTS_DIR="$HOME/.local/share/Archer/bin"

if [[ ! -d "$WALLPAPERS_DIR" ]]; then
    notify-send "Archer" "Wallpapers directory not found at $WALLPAPERS_DIR"
    exit 1
fi

# ─── Find collections ─────────────────────────────────────────────────────────
mapfile -t COLLECTIONS < <(
    find "$WALLPAPERS_DIR" -mindepth 1 -maxdepth 1 -type d \
    | sort \
    | xargs -I{} basename {}
)

if [[ ${#COLLECTIONS[@]} -eq 0 ]]; then
    notify-send "Archer" "No collections found in $WALLPAPERS_DIR"
    exit 1
fi

CURRENT=$(cat "$COLLECTION_FILE" 2>/dev/null || echo "")

# ─── Pick collection via rofi ─────────────────────────────────────────────────
SELECTED=$(printf '%s\n' "${COLLECTIONS[@]}" | rofi -dmenu \
    -p "Select Theme" \
    -theme "$HOME/.config/rofi/set-theme.rasi" \
    -select "$CURRENT")

[[ -z "$SELECTED" ]] && exit 0

if [[ ! -d "$WALLPAPERS_DIR/$SELECTED" ]]; then
    notify-send "Archer" "Collection '$SELECTED' not found"
    exit 1
fi

# ─── Pick mode via rofi ───────────────────────────────────────────────────────
CURRENT_MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "dark")
MODE=$(printf 'dark\nlight\n' | rofi -dmenu \
    -p "Select Mode" \
    -theme "$HOME/.config/rofi/set-theme.rasi" \
    -select "$CURRENT_MODE")

[[ -z "$MODE" ]] && exit 0

# ─── Save collection state ────────────────────────────────────────────────────
mkdir -p "$STATE_DIR"
echo "$SELECTED" > "$COLLECTION_FILE"

notify-send "Archer" "Collection set to '$SELECTED' ($MODE mode)" \
    --icon=preferences-desktop-wallpaper

# ─── Pick random wallpaper from new collection ────────────────────────────────
BG_DIR="$WALLPAPERS_DIR/$SELECTED"
mapfile -t WALLS < <(find -L "$BG_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \
       -o -iname "*.webp" -o -iname "*.gif" \) | sort)

if [[ ${#WALLS[@]} -eq 0 ]]; then
    notify-send "Archer" "No wallpapers found in '$SELECTED'"
    exit 1
fi

RANDOM_WALL="${WALLS[$RANDOM % ${#WALLS[@]}]}"
ln -nsf "$RANDOM_WALL" "$STATE_DIR/current-wallpaper"

# ─── Apply via awww ───────────────────────────────────────────────────────────
if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    uwsm-app -- awww-daemon &
    sleep 0.3
fi

setsid uwsm-app -- awww img "$STATE_DIR/current-wallpaper" \
    --transition-type grow \
    --transition-pos "$(hyprctl cursorpos | grep -E '^[0-9]' || echo '0,0')" \
    --transition-fps 60 \
    --transition-duration 0.8 \
    --resize crop &
disown

# ─── Delegate color/theme pipeline to archer-set-mode ────────────────────────
"$SCRIPTS_DIR/archer-set-mode" "$MODE"
