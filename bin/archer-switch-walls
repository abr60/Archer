#!/usr/bin/env bash
# ============================================================
#  wallpaper-pick.sh
# ============================================================

THEME_NAME=$(cat "$HOME/.config/Archer/current/theme.name" 2>/dev/null || echo "default")
THEME_BG_DIR="$HOME/.config/Archer/current/theme/backgrounds"
USER_BG_DIR="$HOME/.config/Archer/backgrounds/$THEME_NAME"
CURRENT_BG_LINK="$HOME/.config/Archer/current/background"
ROFI_THEME="$HOME/.config/rofi/wallpaper.rasi"
CACHE_DIR="$HOME/.cache/wallpaper-thumbs/$THEME_NAME"
THUMB_SIZE="500"
MATUGEN_HYPRLOCK="$HOME/.config/hypr/bin/matugen-hyprlock.conf"

# --- COLOR EXTRACTION ----------------------------------------
CSS_FILE="$HOME/.config/Archer/current/theme/walker.css"
get_color() {
    grep -m1 "@define-color $1 " "$CSS_FILE" 2>/dev/null \
        | awk '{print $3}' | tr -d ';'
}
C_BASE=$(get_color "base"); C_BASE="${C_BASE:-#1e1e2e}"
C_BORDER_LIGHT="#ffffff22"

mkdir -p "$HOME/.config/hypr/bin"

# --- BOOTSTRAP -----------------------------------------------
if [[ ! -f "$MATUGEN_HYPRLOCK" ]]; then
    cat > "$MATUGEN_HYPRLOCK" << 'EOF'
$foreground      = #e7e0e8
$foreground_dim  = #cbc4cf
$background      = #151218
$primary         = #d5bbfc
$secondary       = #cec2db
$error           = #ffb4ab
EOF
fi

# --- HYPRLAND METRICS ----------------------------------------
col_count=5
mkdir -p "$CACHE_DIR"
if pgrep -x rofi >/dev/null 2>&1; then pkill -x rofi; exit 0; fi

# --- FIND WALLPAPERS -----------------------------------------
declare -A seen
declare -a WALLPAPERS
while IFS= read -r wp; do
    fname=$(basename "$wp")
    if [[ -z "${seen[$fname]+x}" ]]; then
        seen[$fname]=1
        WALLPAPERS+=("$wp")
    fi
done < <(find -L "$USER_BG_DIR" "$THEME_BG_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \
       -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" \) \
    2>/dev/null | sort)

[[ ${#WALLPAPERS[@]} -eq 0 ]] && { notify-send "Wallpaper Picker" "No files found."; exit 1; }

# --- BUILD THUMBNAILS ----------------------------------------
declare -A wp_map
entries=""
current_wall=$(basename "$(readlink -f "$CURRENT_BG_LINK" 2>/dev/null)")

for wp in "${WALLPAPERS[@]}"; do
    base=$(basename "$wp")
    thumb="$CACHE_DIR/${base}.sqre.png"
    if [[ ! -f "$thumb" ]]; then
        ffmpeg -y -i "$wp" \
            -vf "select=eq(n\,0),scale=${THUMB_SIZE}:${THUMB_SIZE}:force_original_aspect_ratio=increase,crop=${THUMB_SIZE}:${THUMB_SIZE}" \
            -vframes 1 "$thumb" >/dev/null 2>&1 || continue
    fi
    wp_map["$base"]="$wp"
    entries+="${base}\0icon\x1f${thumb}\n"
done

# --- LAUNCH ROFI ---------------------------------------------
r_override="window { border-color: ${C_BORDER_LIGHT}; } listview { columns: ${col_count}; }"
selected=$(echo -en "$entries" | rofi -dmenu -i -show-icons -no-custom \
    -theme "$ROFI_THEME" -theme-str "$r_override" -select "$current_wall")
[[ -z "$selected" ]] && exit 0

NEW_WP="${wp_map[$selected]}"
[[ ! -f "$NEW_WP" ]] && exit 1

# --- MP4 CONVERSION ------------------------------------------
if [[ "$NEW_WP" == *.mp4 || "$NEW_WP" == *.MP4 ]]; then
    CONVERTED_GIF="$CACHE_DIR/$(basename "$NEW_WP").gif"
    if [[ ! -f "$CONVERTED_GIF" ]]; then
        ffmpeg -i "$NEW_WP" \
            -vf "fps=24,scale=1920:-1:flags=lanczos,crop=1920:1080,split[s0][s1];[s0]palettegen=max_colors=128[p];[s1][p]paletteuse=dither=sierra2_4a" \
            "$CONVERTED_GIF" >/dev/null 2>&1
    fi
    TARGET_WP="$CONVERTED_GIF"
else
    TARGET_WP="$NEW_WP"
fi

# --- APPLY WALLPAPER -----------------------------------------
ln -nsf "$TARGET_WP" "$CURRENT_BG_LINK"

if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    uwsm-app -- awww-daemon &
    sleep 0.3
fi

setsid uwsm-app -- awww img "$CURRENT_BG_LINK" \
    --transition-type grow \
    --transition-pos "$(hyprctl cursorpos | grep -E '^[0-9]' || echo '0,0')" \
    --transition-fps 60 \
    --transition-duration 0.8 \
    --resize crop &
disown

# --- MATUGEN COLOR GENERATION (Enhanced) ---
if command -v matugen >/dev/null 2>&1; then
    DOMINANT=""
    WAYBAR_CSS="$HOME/.config/waybar/matugen.css"

    # 1. Use imagemagick to find the best dominant color 
    if command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; then
        IM_CMD=$(command -v magick || command -v convert)
        DOMINANT=$(
            "$IM_CMD" "$NEW_WP" \
                -resize 100x100! \
                -quantize transparent \
                +dither -colors 8 \
                -format "%c" histogram:info:- 2>/dev/null \
            | sort -rn \
            | grep -oP '#[0-9A-Fa-f]{6}' \
            | while read -r hex; do
                r=$((16#${hex:1:2})); g=$((16#${hex:3:2})); b=$((16#${hex:5:2}))
                lum=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
                max_c=$(( r > g ? r : g )); max_c=$(( max_c > b ? max_c : b ))
                min_c=$(( r < g ? r : g )); min_c=$(( min_c < b ? min_c : b ))
                chroma=$(( max_c - min_c ))
                # Filter criteria to ensure the color isn't too dark, light, or grey 
                if (( lum >= 25 && lum <= 230 && chroma >= 30 )); then
                    echo "$hex"
                    break
                fi
            done
        )
    fi

    # 2. Apply matugen + dump JSON cache for cava.py / terminal cava
    mkdir -p "$HOME/.cache/matugen"
    if [[ -n "$DOMINANT" ]]; then
        matugen color hex "$DOMINANT" --mode dark
        matugen color hex "$DOMINANT" --mode dark --json hex \
            > "$HOME/.cache/matugen/colors.json"
    else
        matugen image "$NEW_WP" --mode dark
        matugen image "$NEW_WP" --mode dark --json hex \
            > "$HOME/.cache/matugen/colors.json"
    fi

    # 3. Race-condition fix: wait for waybar CSS to update
    for i in $(seq 1 20); do
        if [[ -f "$WAYBAR_CSS" ]] && (( $(date +%s) - $(date -r "$WAYBAR_CSS" +%s 2>/dev/null || echo 0) <= 5 )); then
            break
        fi
        sleep 0.1
    done
    sleep 0.15

    pkill -SIGUSR2 waybar   # reload waybar CSS
    pkill -f cava.py        # restart cava.py so it re-reads colors.json
fi