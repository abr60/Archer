#!/usr/bin/env bash
# =============================================================================
# Toolbox – Unified Hub Launcher
# =============================================================================

TOOLBOX_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

MEDIA="$TOOLBOX_DIR/archer-media-download"
DOTS="$TOOLBOX_DIR/archer-dots-push"
GIF="$TOOLBOX_DIR/archer-mp4-to-gif"
WG="$TOOLBOX_DIR/archer-wg-manager"
SCAN="$TOOLBOX_DIR/archer-clamav-scanner"
SPOOF="$TOOLBOX_DIR/archer-mac-spoofer"
META="$TOOLBOX_DIR/archer-metadata-cleaner"
SHRED="$TOOLBOX_DIR/archer-shredder"
SPOTI="$TOOLBOX_DIR/archer-spotify-music-download"
WIFIQR="$TOOLBOX_DIR/archer-wifi-qr"

launch_tui() {
    local script="$1"
    local title="$2"
    local class="${3:-kitty}"

    if [ "$class" != "kitty" ]; then
        uwsm-app -- kitty --class="$class" --title="$title" -e bash "$script" &
    else
        uwsm-app -- kitty --title="$title" \
            --override initial_window_width=900 \
            --override initial_window_height=600 \
            -e bash "$script" &
    fi
}

MENU="  Github Push
  YTdlp
  Spotify
󰿔  MP4 → GIF
󰖩  WiFi QR"

chosen=$(echo -e "$MENU" | rofi -dmenu \
    -i \
    -p "󱁤 Toolbox" \
    -kb-cancel "Escape,MouseSecondary,MousePrimary")

[[ -z "$chosen" ]] && exit 0

case "$chosen" in
    *"YTdlp"*)       launch_tui "$MEDIA" "media-download" "media-download" ;;
    *"Github Push"*) launch_tui "$DOTS"  "dots-push"      "dots-push"      ;;
    *"MP4"*)         launch_tui "$GIF"   "mp4-to-gif"     "mp4-to-gif"     ;;
    *"WireGuard"*)   bash "$WG"    &                      ;;
    *"Malware"*)     bash "$SCAN"  &                      ;;
    *"MAC Spoofer"*) bash "$SPOOF" &                      ;;
    *"Metadata"*)    bash "$META"  &                      ;;
    *"Spotify"*)     launch_tui "$SPOTI" "archer-spotify-music-download" ;;
    *"Shredder"*)    bash "$SHRED" &                      ;;
    *"WiFi QR"*)     uwsm-app -- kitty --class=wifi-qr --title=wifi-qr -e bash "$WIFIQR" & ;;
esac
