#!/bin/bash

# archer:summary=Lock the computer and turn off the display
# archer:group=system
# archer:name=lock
# archer:examples=archer system lock

# Check if quickshell is already locking the screen
if ! pidof quickshell >/dev/null; then
  (
    # Call the quickshell lock script synchronously so it blocks until unlocked
    /home/abr/.local/share/quickshell-lockscreen/lock.sh
    system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.archer.screensaver

if [[ ${ARCHER_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    # Double check quickshell is still active before shutting down backlights
    pidof quickshell >/dev/null || exit 0
    brightness-keyboard off
    brightness-display off
  ) &
fi