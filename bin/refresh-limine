#!/usr/bin/env bash
# archer:summary=Refresh Limine header and regenerate boot entries

set -euo pipefail

ARCHER_DIR="${ARCHER_DIR:-$HOME/.local/share/Archer}"
TEMPLATE="$ARCHER_DIR/default/limine/limine.conf"
DEST="/boot/limine.conf"

if [[ ! -f "$TEMPLATE" ]]; then
    echo "ERROR: Template not found at $TEMPLATE" >&2
    exit 1
fi

# Deploy header (flat path — not /boot/limine/limine.conf)
sudo cp "$TEMPLATE" "$DEST"
echo "Limine header deployed to $DEST"

# Regenerate entries (kernel cmdline comes from /etc/kernel/cmdline + drop-ins)
if command -v limine-entry-tool &>/dev/null; then
    sudo limine-entry-tool
    echo "Boot entries regenerated via limine-entry-tool"
else
    echo "WARN: limine-entry-tool not found — header only, no entries generated" >&2
fi
