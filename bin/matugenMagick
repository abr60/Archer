#!/usr/bin/env bash
# =============================================================================
# matugenMagick — Post-matugen tasks: XDG bg symlink, icon theme, notify
# =============================================================================
STATE_DIR="$HOME/.local/state/Archer"
CURRENT_WP_LINK="$STATE_DIR/current-wallpaper"

wallpaper_path=$(readlink -f "$CURRENT_WP_LINK" 2>/dev/null || echo "")
if [[ -z "$wallpaper_path" || ! -f "$wallpaper_path" ]]; then
    notify-send -u critical "MatugenMagick" "Could not resolve current wallpaper path"
    exit 1
fi

# ─── XDG wallpaper symlink ────────────────────────────────────────────────────
mkdir -p "$HOME/.local/share"
ln -sf "$wallpaper_path" "$HOME/.local/share/bg"

# ─── Yaru icon theme from dominant color hue ─────────────────────────────────
MODE=$(cat "$STATE_DIR/current-mode" 2>/dev/null || echo "dark")
IM_CMD=$(command -v magick || command -v convert || echo "")

if [[ -n "$IM_CMD" ]]; then
    DOMINANT=$(
        "$IM_CMD" "$wallpaper_path" \
            -resize 100x100! \
            -quantize transparent \
            +dither -colors 8 \
            -format "%c" histogram:info:- 2>/dev/null \
        | sort -rn \
        | grep -oP '#[0-9A-Fa-f]{6}' \
        | while read -r hex; do
            r=$((16#${hex:1:2}))
            g=$((16#${hex:3:2}))
            b=$((16#${hex:5:2}))
            lum=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
            max_c=$(( r > g ? r : g ))
            max_c=$(( max_c > b ? max_c : b ))
            min_c=$(( r < g ? r : g ))
            min_c=$(( min_c < b ? min_c : b ))
            chroma=$(( max_c - min_c ))
            if (( lum >= 25 && lum <= 230 && chroma >= 30 )); then
                echo "$hex"
                break
            fi
        done
    )

    if [[ -n "$DOMINANT" ]]; then
        r=$((16#${DOMINANT:1:2}))
        g=$((16#${DOMINANT:3:2}))
        b=$((16#${DOMINANT:5:2}))

        # Convert RGB to hue (0-360)
        max_c=$(( r > g ? r : g ))
        max_c=$(( max_c > b ? max_c : b ))
        min_c=$(( r < g ? r : g ))
        min_c=$(( min_c < b ? min_c : b ))
        chroma=$(( max_c - min_c ))

        if (( chroma == 0 )); then
            hue=0
        elif (( max_c == r )); then
            hue=$(( (60 * (g - b) / chroma + 360) % 360 ))
        elif (( max_c == g )); then
            hue=$(( 60 * (b - r) / chroma + 120 ))
        else
            hue=$(( 60 * (r - g) / chroma + 240 ))
        fi

        # Map hue to Yaru variant
        if   (( hue >= 345 || hue < 15  )); then YARU_COLOR="Yaru-red"
        elif (( hue >= 15  && hue < 45  )); then YARU_COLOR="Yaru-wartybrown"
        elif (( hue >= 45  && hue < 75  )); then YARU_COLOR="Yaru-yellow"
        elif (( hue >= 75  && hue < 105 )); then YARU_COLOR="Yaru-olive"
        elif (( hue >= 105 && hue < 150 )); then YARU_COLOR="Yaru-sage"
        elif (( hue >= 150 && hue < 195 )); then YARU_COLOR="Yaru-prussiangreen"
        elif (( hue >= 195 && hue < 255 )); then YARU_COLOR="Yaru-blue"
        elif (( hue >= 255 && hue < 300 )); then YARU_COLOR="Yaru-purple"
        elif (( hue >= 300 && hue < 345 )); then YARU_COLOR="Yaru-magenta"
        fi

        [[ "$MODE" == "dark" ]] && ICON_THEME="${YARU_COLOR}-dark" || ICON_THEME="$YARU_COLOR"
        gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME"
    fi
fi

# ─── Completion notification ──────────────────────────────────────────────────
notify-send \
    -h string:x-canonical-private-synchronous:archer_matugen \
    "Archer" "Wallpaper & colors applied" \
    -i "$HOME/.local/share/bg"