#!/bin/bash

# omarchy:summary=Unblock and restart Wi-Fi via NetworkManager, with connectivity check.

notify() { command -v notify-send &>/dev/null && notify-send -a "WiFi" "$1" "$2"; echo -e "$1: $2"; }

echo -e "Unblocking wifi...\n"
rfkill unblock wifi
rfkill list wifi

echo -e "\nCycling NM radio...\n"
nmcli radio wifi off
sleep 2
nmcli radio wifi on
sleep 4

# Connectivity check
if nmcli -t -f STATE general | grep -q "^connected"; then
  if ping -c 2 -W 3 1.1.1.1 &>/dev/null; then
    notify "WiFi" "✓ Connected and internet is reachable."
  else
    notify "WiFi" "⚠ Associated but no internet. Try running again or check NM logs."
  fi
else
  notify "WiFi" "✗ Not connected to any network."
fi
