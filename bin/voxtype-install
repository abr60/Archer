#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  pkg-add wtype voxtype-bin

  # Run setup first so it creates the default files/directories
  voxtype setup --download --no-post-install
  
  if hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  # Get the actual user's home directory and Archer path (handles sudo safely)
  REAL_USER="${SUDO_USER:-$USER}"
  USER_HOME=$(eval echo "~$REAL_USER")
  ARCHER_PATH="$USER_HOME/Archer"

  # Copy custom config into the real user's home directory from Archer
  mkdir -p "$USER_HOME/.config/voxtype"
  cp "$ARCHER_PATH/default/voxtype/config.toml" "$USER_HOME/.config/voxtype/"

  restart-waybar
  notify-send "    Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
