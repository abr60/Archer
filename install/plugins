#!/usr/bin/env bash
# =============================================================================
# plugins.sh — Install Hyprland plugins via hyprpm
# =============================================================================

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

if ! command -v hyprpm &>/dev/null; then
    warn "hyprpm not found — skipping plugin setup"
    exit 0
fi

# Update plugin headers
hyprpm update || warn "hyprpm update failed — continuing anyway"

# Add official Hyprland plugins
PLUGIN_URL="https://github.com/hyprwm/hyprland-plugins"

echo "  Adding plugin repo: hyprland-plugins..."
hyprpm add "$PLUGIN_URL" || { warn "Failed to add hyprland-plugins repo"; exit 0; }

hyprpm enable hyprexpo || warn "Failed to enable hyprexpo"
hyprpm reload || warn "hyprpm reload failed"

ok "Hyprland plugins set up"