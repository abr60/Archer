#!/usr/bin/env bash
# =============================================================================
# local-bin.sh — Setup binaries, desktop applications & icons
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/Archer"
BIN_SOURCE="$DOTS_DIR/bin/batty"
BIN_DEST="$HOME/.cargo/bin"
APPS_SRC="$DOTS_DIR/applications"
DESKTOP_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

msg()  { echo -e "${BLUE}==>${NC} $1"; }
ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

# ==========================================
# 1. BATTY BINARY
# ==========================================
if [[ -f "$BIN_SOURCE" ]]; then
    mkdir -p "$BIN_DEST"
    cp -f "$BIN_SOURCE" "$BIN_DEST/"
    chmod +x "$BIN_DEST/batty"
    ok "Binary 'batty' installed to $BIN_DEST"
else
    warn "Source 'batty' not found at $BIN_SOURCE"
fi

# ==========================================
# 2. DESKTOP FILES
# ==========================================
if [[ -d "$APPS_SRC" ]]; then
    mkdir -p "$DESKTOP_DIR"
    desktop_count=$(find "$APPS_SRC" -maxdepth 1 -name "*.desktop" | wc -l)

    if [[ "$desktop_count" -gt 0 ]]; then
        cp "$APPS_SRC"/*.desktop "$DESKTOP_DIR/"
        ok "Copied $desktop_count .desktop files to $DESKTOP_DIR"
    else
        warn "No .desktop files found in $APPS_SRC"
    fi
else
    warn "Applications folder not found at $APPS_SRC — skipping"
fi

# ==========================================
# 3. ICONS
# ==========================================
if [[ -d "$APPS_SRC/icons" ]]; then
    mkdir -p "$ICONS_DIR"
    icon_count=$(find "$APPS_SRC/icons" -maxdepth 1 -type f | wc -l)

    if [[ "$icon_count" -gt 0 ]]; then
        cp "$APPS_SRC/icons/"* "$ICONS_DIR/"
        ok "Copied $icon_count icons to $ICONS_DIR"
    else
        warn "No icons found in $APPS_SRC/icons"
    fi
else
    warn "Icons folder not found at $APPS_SRC/icons — skipping"
fi

# ==========================================
# 4. UPDATE CACHES
# ==========================================
update-desktop-database "$DESKTOP_DIR" 2>/dev/null && ok "Desktop database updated" || true
gtk-update-icon-cache "$ICONS_DIR" 2>/dev/null && ok "Icon cache updated" || true