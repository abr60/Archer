#!/usr/bin/env bash
# =============================================================================
# reload.sh — Reload Hyprland and Waybar
# =============================================================================

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

# Reload Hyprland config
hyprctl reload 2>/dev/null && ok "Hyprland reloaded" || warn "Hyprland not running"

# Restart Waybar
if command -v omarchy-restart-waybar &>/dev/null; then
    omarchy-restart-waybar && ok "Waybar restarted" || warn "omarchy-restart-waybar failed"
else
    pkill waybar 2>/dev/null || true
    sleep 0.5
    waybar &disown 2>/dev/null && ok "Waybar restarted" || warn "Waybar failed to start"
fi

echo -e "\n${GREEN}UI Components Refresh Complete${NC}"