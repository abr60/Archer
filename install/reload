#!/usr/bin/env bash
# =============================================================================
# reload.sh — Reload Hyprland and QuickShell
# =============================================================================

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

# Reload Hyprland config
hyprctl reload 2>/dev/null && ok "Hyprland reloaded" || warn "Hyprland not running"

# Restart QuickShell
if command -v quickshell &>/dev/null; then
    pkill quickshell 2>/dev/null || true
    sleep 0.5
    quickshell &disown 2>/dev/null && ok "QuickShell restarted" || warn "QuickShell failed to start"
else
    warn "QuickShell not found — skipping"
fi

echo -e "\n${GREEN}UI Components Refresh Complete${NC}"
