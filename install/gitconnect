#!/bin/bash

# ─────────────────────────────────────────────
#  gitconnect.sh — drunk-particles repo sync
#  repos: ~/dots  ~/Wallpapers
# ─────────────────────────────────────────────

GITHUB_USER="drunk-particles"
REPOS=(
  "$HOME/dots|git@github.com:drunk-particles/dots.git"
  "$HOME/Wallpapers|git@github.com:drunk-particles/Wallpapers.git"
)

# colors via gum style
header() {
  gum style \
    --foreground 212 --border-foreground 212 --border double \
    --align center --width 50 --margin "1 2" --padding "1 2" \
    "󰊢  gitconnect" "" "drunk-particles · repo sync"
}

info()    { gum style --foreground 39  "  $*"; }
success() { gum style --foreground 82  "  $*"; }
warn()    { gum style --foreground 214 "  $*"; }
error()   { gum style --foreground 196 "  $*"; }
section() { gum style --foreground 212 --bold "── $* ──────────────────────────"; }

# ─── SSH KEY CHECK ───────────────────────────
check_ssh_key() {
  section "SSH Key"

  if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
    success "SSH key found."
    return 0
  fi

  warn "No SSH key found on this machine."
  echo ""

  if gum confirm "Generate a new SSH key now?"; then
    local email
    email=$(gum input --placeholder "your GitHub email address")
    [[ -z "$email" ]] && { error "No email entered. Aborting."; exit 1; }

    ssh-keygen -t ed25519 -C "$email" -f "$HOME/.ssh/id_ed25519" -N ""
    success "Key generated!"
  else
    error "SSH key required. Exiting."
    exit 1
  fi
}

# ─── ADD KEY TO GITHUB ───────────────────────
prompt_add_key() {
  section "Add Key to GitHub"

  local pubkey
  pubkey=$(cat "$HOME/.ssh/id_ed25519.pub")

  gum style --foreground 226 "Copy this key and add it to GitHub:"
  echo ""
  gum style --border rounded --padding "1 2" --border-foreground 226 "$pubkey"
  echo ""
  gum style --foreground 39 "  github.com → Settings → SSH and GPG keys → New SSH key"
  echo ""

  gum confirm "Done adding the key to GitHub?" || { error "Add the key first, then re-run."; exit 1; }
}

# ─── TEST SSH ────────────────────────────────
test_ssh() {
  section "Testing GitHub SSH Connection"

  local result
  result=$(ssh -T git@github.com 2>&1)

  if echo "$result" | grep -q "successfully authenticated"; then
    success "Connected as $GITHUB_USER"
    return 0
  else
    error "SSH auth failed: $result"
    return 1
  fi
}

# ─── SET REMOTE ──────────────────────────────
setup_remote() {
  local path="$1"
  local remote="$2"
  local name
  name=$(basename "$path")

  if [[ ! -d "$path/.git" ]]; then
    warn "$name: not a git repo, skipping."
    return
  fi

  git -C "$path" remote set-url origin "$remote" 2>/dev/null \
    || git -C "$path" remote add origin "$remote"

  success "$name → $remote"
}

# ─── PUSH REPO ───────────────────────────────
push_repo() {
  local path="$1"
  local name
  name=$(basename "$path")

  section "Pushing $name"

  local status
  status=$(git -C "$path" status --short)

  if [[ -z "$status" ]]; then
    info "$name: nothing to commit."
    return
  fi

  gum style --foreground 245 "$status"
  echo ""

  local msg
  msg=$(gum input --placeholder "Commit message for $name" --value "sync: $(date '+%Y-%m-%d')")
  [[ -z "$msg" ]] && { warn "No message, skipping $name."; return; }

  git -C "$path" add .
  git -C "$path" commit -m "$msg"
  git -C "$path" push && success "$name pushed!" || error "$name push failed."
}

# ─── GIT CONFIG CHECK ────────────────────────
ensure_git_identity() {
  local name email
  name=$(git config --global user.name)
  email=$(git config --global user.email)

  if [[ -z "$name" || -z "$email" ]]; then
    section "Git Identity"
    warn "Git identity not set."

    name=$(gum input --placeholder "Your name (e.g. drunk-particles)")
    email=$(gum input --placeholder "Your email")

    git config --global user.name "$name"
    git config --global user.email "$email"
    success "Identity saved."
  fi
}

# ─── MAIN ────────────────────────────────────
clear
header

check_ssh_key

# Check if key is already known to GitHub
result=$(ssh -T git@github.com 2>&1)
if ! echo "$result" | grep -q "successfully authenticated"; then
  prompt_add_key
fi

test_ssh || exit 1

ensure_git_identity

echo ""
section "Setting Remotes"
for entry in "${REPOS[@]}"; do
  IFS="|" read -r path remote <<< "$entry"
  setup_remote "$path" "$remote"
done

echo ""
if gum confirm "Push changes to both repos now?"; then
  for entry in "${REPOS[@]}"; do
    IFS="|" read -r path remote <<< "$entry"
    [[ -d "$path/.git" ]] && push_repo "$path"
  done
fi

echo ""
success "All done. You're synced."