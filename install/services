#!/bin/bash
# =============================================================================
# services.sh — Enable required systemd services for Archer setup
# =============================================================================

set -uo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

info()    { echo -e "${GREEN}[+]${NC} $1"; }
warn()    { echo -e "${YELLOW}[!]${NC} $1"; }
error()   { echo -e "${RED}[x]${NC} $1"; }
section() { echo -e "\n${CYAN}──${NC} $1"; }

DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true && warn "Dry-run mode — no changes will be made."

# ─── result tracking ──────────────────────────────────────────────────────────

declare -a ENABLED=()
declare -a SKIPPED=()
declare -a FAILED=()
declare -a MISSING=()

# ─── helpers ──────────────────────────────────────────────────────────────────

_unit_exists_system() { systemctl cat "$1" &>/dev/null; }
_unit_exists_user()   { systemctl --user cat "$1" &>/dev/null; }

_is_enabled_system()  { systemctl is-enabled "$1" &>/dev/null; }
_is_enabled_user()    { systemctl --user is-enabled "$1" &>/dev/null; }

enable_system_service() {
    local svc=$1
    if ! _unit_exists_system "$svc"; then
        error "$svc not found — skipping."
        MISSING+=("$svc")
        return
    fi
    if _is_enabled_system "$svc"; then
        info "$svc already enabled — skipping."
        SKIPPED+=("$svc")
        return
    fi
    if $DRY_RUN; then
        info "[dry-run] Would enable $svc"
        return
    fi
    info "Enabling $svc..."
    if sudo systemctl enable "$svc" && sudo systemctl start "$svc"; then
        ENABLED+=("$svc")
    else
        error "Failed to enable $svc."
        FAILED+=("$svc")
    fi
}

enable_user_service() {
    local svc=$1
    if ! _unit_exists_user "$svc"; then
        error "$svc (user) not found — skipping."
        MISSING+=("$svc (user)")
        return
    fi
    if _is_enabled_user "$svc"; then
        info "$svc (user) already enabled — skipping."
        SKIPPED+=("$svc (user)")
        return
    fi
    if $DRY_RUN; then
        info "[dry-run] Would enable $svc (user)"
        return
    fi
    info "Enabling $svc (user)..."
    if systemctl --user enable "$svc" && systemctl --user start "$svc"; then
        ENABLED+=("$svc (user)")
    else
        error "Failed to enable $svc (user)."
        FAILED+=("$svc (user)")
    fi
}

# ─── system services ──────────────────────────────────────────────────────────

section "System services"

enable_system_service tlp.service
enable_system_service NetworkManager.service
enable_system_service NetworkManager-dispatcher.service
enable_system_service bluetooth.service
enable_system_service greetd.service
enable_system_service ufw.service   # ufw skipped — not in use
enable_system_service linux-enable-ir-emitter.service
enable_system_service thinkfan.service

# ─── user services ────────────────────────────────────────────────────────────

section "User services"

enable_user_service mpd.service
enable_user_service mpd-mpris.service

# ─── summary ──────────────────────────────────────────────────────────────────

echo ""
section "Summary"

[[ ${#ENABLED[@]}  -gt 0 ]] && echo -e "${GREEN}  Enabled  (${#ENABLED[@]}):${NC}  ${ENABLED[*]}"
[[ ${#SKIPPED[@]}  -gt 0 ]] && echo -e "${YELLOW}  Skipped  (${#SKIPPED[@]}):${NC}  ${SKIPPED[*]}"
[[ ${#MISSING[@]}  -gt 0 ]] && echo -e "${YELLOW}  Missing  (${#MISSING[@]}):${NC}  ${MISSING[*]}"
[[ ${#FAILED[@]}   -gt 0 ]] && echo -e "${RED}  Failed   (${#FAILED[@]}):${NC}  ${FAILED[*]}"

echo ""

if [[ ${#FAILED[@]} -gt 0 ]]; then
    error "Some services failed. Check the output above."
    exit 1
else
    info "All services processed. Reboot recommended."
fi