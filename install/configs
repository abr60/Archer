#!/usr/bin/env bash
# =============================================================================
# configs.sh — Symlink hyprland/.config → ~/.config (Using Stow)
#            — Copy pam.d files → /etc/pam.d (with backup)
#            — Copy wallpaper & recording scripts → ~/.local/share/omarchy/bin (with backup)
#            — Fix screenshot & screenrecord output directories
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/dots"
CONFIG_DEST="$HOME/.config"
PAM_SOURCE="$CONFIG_DEST/hypr/assets/pam.d"
PAM_DEST="/etc/pam.d"
WALLPAPER_SOURCE="$CONFIG_DEST/hypr/scripts/wallpaper and recording"
OMARCHY_BIN="$HOME/.local/share/omarchy/bin"
BACKUP_DIR="$HOME/.config/dots-backups/$(date +%Y%m%d_%H%M%S)"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log()  { echo -e "${BLUE}==>${NC} $1"; }
ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }
err()  { echo -e "${RED} ✗${NC} $1"; }

# ==========================================
# 0. CHECKS
# ==========================================
if ! command -v stow &>/dev/null; then
    log "stow not found. Installing..."
    sudo pacman -S --needed --noconfirm stow
    ok "stow installed"
else
    ok "stow already installed"
fi

if [[ ! -d "$DOTS_DIR/hyprland" ]]; then
    err "$DOTS_DIR/hyprland not found. Aborting."
    exit 1
fi

# ==========================================
# 1. REMOVE EXISTING CONFIGS (clean slate)
# ==========================================
log "Removing existing config dirs that overlap with dots..."

# These are the dirs present in dots/hyprland/.config
STOW_DIRS=(
    alacritty btop calibre cava elephant fastfetch ghostty
    gtk-3.0 gtk-4.0 hypr mako matugen mpv rofi sioyek
    spicetify swayosd uwsm vlc walker waybar
)

for dir in "${STOW_DIRS[@]}"; do
    target="$CONFIG_DEST/$dir"
    if [[ -L "$target" ]]; then
        rm "$target"
        ok "Removed symlink: $target"
    elif [[ -d "$target" ]]; then
        rm -rf "$target"
        ok "Removed dir: $target"
    fi
done

# Remove starship.toml if it exists
if [[ -e "$CONFIG_DEST/starship.toml" ]]; then
    rm -f "$CONFIG_DEST/starship.toml"
    ok "Removed: $CONFIG_DEST/starship.toml"
fi

# ==========================================
# 2. STOW HYPRLAND
# ==========================================
log "Running stow to symlink hyprland/.config → ~/.config..."
cd "$DOTS_DIR"
stow hyprland
ok "Stow complete — ~/.config entries are now symlinked from $DOTS_DIR/hyprland"

# Make all scripts executable
log "Ensuring scripts are executable..."
find "$CONFIG_DEST/hypr/scripts" -type f -exec chmod +x {} + 2>/dev/null || true
ok "Script permissions updated"

# ==========================================
# 3. PAM.D FILES (with backup)
# ==========================================
if [[ -d "$PAM_SOURCE" ]]; then
    mkdir -p "$BACKUP_DIR/pam.d"
    log "Backing up existing pam.d files → $BACKUP_DIR/pam.d"

    for f in "$PAM_SOURCE"/*; do
        fname=$(basename "$f")
        if [[ -f "$PAM_DEST/$fname" ]]; then
            cp "$PAM_DEST/$fname" "$BACKUP_DIR/pam.d/$fname"
            ok "Backed up /etc/pam.d/$fname"
        fi
    done

    log "Copying pam.d files → $PAM_DEST"
    sudo cp "$PAM_SOURCE/"* "$PAM_DEST/"
    sudo chmod 644 "$PAM_DEST/"*
    ok "pam.d files copied to $PAM_DEST"
else
    warn "pam.d source not found at $PAM_SOURCE — skipping"
fi

# ==========================================
# 4. WALLPAPER & RECORDING SCRIPTS (with backup)
# ==========================================
mkdir -p "$OMARCHY_BIN"
mkdir -p "$BACKUP_DIR/omarchy-bin"

if [[ -n "$(ls -A "$OMARCHY_BIN" 2>/dev/null)" ]]; then
    log "Backing up existing omarchy bin files → $BACKUP_DIR/omarchy-bin"
    cp -r "$OMARCHY_BIN"/. "$BACKUP_DIR/omarchy-bin/"
    ok "Backed up $OMARCHY_BIN"
fi

if [[ -d "$WALLPAPER_SOURCE" ]]; then
    log "Copying wallpaper & recording scripts → $OMARCHY_BIN"
    cp -r "$WALLPAPER_SOURCE"/. "$OMARCHY_BIN/"
    chmod +x "$OMARCHY_BIN"/*
    ok "Scripts copied → $OMARCHY_BIN"
else
    warn "'wallpaper and recording' folder not found at $WALLPAPER_SOURCE — skipping"
fi

# ==========================================
# 5. FIX SCREENSHOT & SCREENRECORD OUTPUT DIRS
# ==========================================
log "Updating screenshot & screenrecord output directories..."

SCREENSHOT_BIN="$OMARCHY_BIN/omarchy-cmd-screenshot"
SCREENRECORD_BIN="$OMARCHY_BIN/omarchy-cmd-screenrecord"

if [[ -f "$SCREENSHOT_BIN" ]]; then
    sed -i 's|${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots|$HOME/Pictures/Screenshots|g' "$SCREENSHOT_BIN"
    ok "Screenshot dir updated → ~/Pictures/Screenshots"
else
    warn "omarchy-cmd-screenshot not found — skipping"
fi

if [[ -f "$SCREENRECORD_BIN" ]]; then
    sed -i 's|${XDG_VIDEOS_DIR:-$HOME/Videos/Screen Records}|$HOME/Videos/Screen Records|g' "$SCREENRECORD_BIN"
    ok "Screenrecord dir updated → ~/Videos/Screen Records"
else
    warn "omarchy-cmd-screenrecord not found — skipping"
fi

mkdir -p "$HOME/Pictures/Screenshots" "$HOME/Videos/Screen Records"
ok "Output directories created"

ok "All backups saved to $BACKUP_DIR"

# ==========================================
# 6. SYSTEM SETUP
# ==========================================
log "Running system setup..."

#xhost +si:localuser:root && ok "xhost updated for root" || warn "xhost failed — skipping"

#sudo linux-enable-ir-emitter configure && ok "IR emitter configured" || warn "linux-enable-ir-emitter configure failed — skipping"