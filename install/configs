#!/usr/bin/env bash
# =============================================================================
# configs — Symlink config/ → ~/.config (Using Stow)
#         — Copy pam.d files → /etc/pam.d (with backup)
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/.local/share/Archer"
CONFIG_DEST="$HOME/.config"
PAM_SOURCE="$CONFIG_DEST/hypr/assets/pam.d"
PAM_DEST="/etc/pam.d"
BACKUP_DIR="$HOME/.config/archer-backups/$(date +%Y%m%d_%H%M%S)"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log()  { echo -e "${BLUE}==>${NC} $1"; }
ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }
err()  { echo -e "${RED} ✗${NC} $1"; }

# ==========================================
# 0. CHECKS
# ==========================================
if ! command -v stow &>/dev/null; then
    log "stow not found. Installing..."
    sudo pacman -S --needed --noconfirm stow
    ok "stow installed"
else
    ok "stow already installed"
fi

if [[ ! -d "$DOTS_DIR/config" ]]; then
    err "$DOTS_DIR/config not found. Aborting."
    exit 1
fi

# ==========================================
# 1. REMOVE EXISTING CONFIGS (clean slate)
# ==========================================
log "Removing existing config dirs that overlap with dots..."

STOW_DIRS=(
    btop
    calibre
    cava
    fastfetch
    ghostty
    hypr
    matugen
    mpv
    rmpc
    rofi
    sioyek
    spicetify
    swaync
    swayosd
    uwsm
)

for dir in "${STOW_DIRS[@]}"; do
    target="$CONFIG_DEST/$dir"
    if [[ -L "$target" ]]; then
        rm "$target"
        ok "Removed symlink: $target"
    elif [[ -d "$target" ]]; then
        rm -rf "$target"
        ok "Removed dir: $target"
    fi
done

# Remove starship.toml if it exists
if [[ -e "$CONFIG_DEST/starship.toml" ]]; then
    rm -f "$CONFIG_DEST/starship.toml"
    ok "Removed: $CONFIG_DEST/starship.toml"
fi

# ==========================================
# 2. STOW CONFIG
# ==========================================
log "Running stow to symlink config/ → ~/.config..."
cd "$DOTS_DIR"
stow --target="$HOME/.config" config
ok "Stow complete — ~/.config entries are now symlinked from $DOTS_DIR/config"

# Make all scripts executable
log "Ensuring scripts are executable..."
find "$CONFIG_DEST/hypr/scripts" -type f -exec chmod +x {} + 2>/dev/null || true
ok "Script permissions updated"

# ==========================================
# 3. PAM.D FILES (with backup)
# ==========================================
if [[ -d "$PAM_SOURCE" ]]; then
    mkdir -p "$BACKUP_DIR/pam.d"
    log "Backing up existing pam.d files → $BACKUP_DIR/pam.d"

    for f in "$PAM_SOURCE"/*; do
        fname=$(basename "$f")
        if [[ -f "$PAM_DEST/$fname" ]]; then
            cp "$PAM_DEST/$fname" "$BACKUP_DIR/pam.d/$fname"
            ok "Backed up /etc/pam.d/$fname"
        fi
    done

    log "Copying pam.d files → $PAM_DEST"
    sudo cp "$PAM_SOURCE/"* "$PAM_DEST/"
    sudo chmod 644 "$PAM_DEST/"*
    ok "pam.d files copied to $PAM_DEST"
else
    warn "pam.d source not found at $PAM_SOURCE — skipping"
fi

ok "All backups saved to $BACKUP_DIR"

# ==========================================
# 4. CREATE OUTPUT DIRECTORIES
# ==========================================
mkdir -p "$HOME/Pictures/Screenshots"
mkdir -p "$HOME/Videos/Screen Recordings"
ok "Output directories created"
