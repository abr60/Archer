#!/bin/bash

# =============================================================================
# install/thinkfan.sh — Thinkfan setup for ThinkPad T14 Gen 2i
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTS_DIR="$(dirname "$SCRIPT_DIR")"
CONF_SRC="$DOTS_DIR/thinkfan/thinkfan.conf"

echo "==> Setting up thinkfan..."

# Enable fan control via thinkpad_acpi
echo "options thinkpad_acpi fan_control=1" | sudo tee /etc/modprobe.d/thinkpad_acpi.conf

# Copy config
sudo cp "$CONF_SRC" /etc/thinkfan.conf

# Enable and start service
sudo systemctl enable --now thinkfan

echo "==> Thinkfan setup complete."