#!/usr/bin/env bash
# =============================================================================
# wallpapers — Clone Wallpapers repository
# Clones https://github.com/drunk-particles/Wallpapers.git to ~/Wallpapers
# =============================================================================

set -uo pipefail

WALLPAPERS_DIR="$HOME/Wallpapers"
REPO_URL="https://github.com/drunk-particles/Wallpapers.git"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

msg() { echo -e "${BLUE}==>${NC} $1"; }
ok()  { echo -e "${GREEN} ✓${NC} $1"; }
warn(){ echo -e "${YELLOW} !${NC} $1"; }
err() { echo -e "${RED} ✗${NC} $1"; }

if [[ -d "$WALLPAPERS_DIR/.git" ]]; then
    msg "Wallpapers repo already exists — pulling latest..."
    git -C "$WALLPAPERS_DIR" pull || warn "Pull failed — continuing with existing wallpapers"
    ok "Wallpapers up to date"
    exit 0
fi

if [[ -d "$WALLPAPERS_DIR" ]] && [[ -n "$(ls -A "$WALLPAPERS_DIR")" ]]; then
    warn "$WALLPAPERS_DIR already exists and is not empty — skipping clone"
    exit 0
fi

msg "Cloning Wallpapers to $WALLPAPERS_DIR..."
if git clone "$REPO_URL" "$WALLPAPERS_DIR"; then
    ok "Wallpapers cloned to $WALLPAPERS_DIR"
else
    err "Failed to clone Wallpapers — check your network connection"
    exit 1
fi
