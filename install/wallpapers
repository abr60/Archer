#!/usr/bin/env bash
# =============================================================================
# wallpapers — Clone Wallpapers repository
# Clones https://github.com/drunk-particles/Wallpapers.git to ~/Wallpapers
# Updates install report with wallpapers status.
# =============================================================================

set -uo pipefail

WALLPAPERS_DIR="$HOME/Wallpapers"
REPO_URL="https://github.com/drunk-particles/Wallpapers.git"
REPORT_FILE="$HOME/.local/state/Archer/install-report.txt"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

msg()  { echo -e "${BLUE}==>${NC} $1"; }
ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }
err()  { echo -e "${RED} ✗${NC} $1"; }

START=$SECONDS

update_report() {
    local status="$1"
    if [[ -f "$REPORT_FILE" ]]; then
        # Replace the placeholder line written by packages-aur
        sed -i "s| Status : pending (set by wallpapers script)| Status : $status|" "$REPORT_FILE"
    fi
}

if [[ -d "$WALLPAPERS_DIR/.git" ]]; then
    msg "Wallpapers repo already exists — pulling latest..."
    if git -C "$WALLPAPERS_DIR" pull; then
        DURATION=$(( SECONDS - START ))
        ok "Wallpapers up to date"
        update_report "Updated (git pull) — ${DURATION}s"
    else
        warn "Pull failed — continuing with existing wallpapers"
        update_report "Pull failed — existing wallpapers kept"
    fi
    exit 0
fi

if [[ -d "$WALLPAPERS_DIR" ]] && [[ -n "$(ls -A "$WALLPAPERS_DIR")" ]]; then
    warn "$WALLPAPERS_DIR already exists and is not empty — skipping clone"
    update_report "Skipped — directory already exists and is not empty"
    exit 0
fi

msg "Cloning Wallpapers to $WALLPAPERS_DIR..."
if git clone "$REPO_URL" "$WALLPAPERS_DIR"; then
    DURATION=$(( SECONDS - START ))
    ok "Wallpapers cloned to $WALLPAPERS_DIR"
    update_report "Cloned successfully to $WALLPAPERS_DIR — ${DURATION}s"
else
    err "Failed to clone Wallpapers — check your network connection"
    update_report "Clone FAILED — network error"
    exit 1
fi
