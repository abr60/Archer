#!/usr/bin/env bash
# =============================================================================
# Waydroid - UFW Networking Rules
# Only runs if waydroid is already installed on the system
# =============================================================================

if ! command -v waydroid &>/dev/null; then
    echo "Waydroid not found — skipping"
    exit 0
fi

echo "Waydroid detected, applying UFW rules..."

if ! sudo ufw status | grep -q "Status: active"; then
    echo "UFW inactive — enabling..."
    sudo ufw enable
fi

sudo ufw allow 53
sudo ufw allow 67
sudo ufw default allow FORWARD
sudo ufw reload

echo "Waydroid UFW rules applied"

# ==========================================
# Hyprland window rule
# ==========================================
HYPR_RULES="$HOME/.config/hypr/rules.conf"
HYPR_RULE="windowrule = fullscreen on, match:class ^(Waydroid)$"

if [[ -f "$HYPR_RULES" ]] && ! grep -qF "$HYPR_RULE" "$HYPR_RULES"; then
    echo "$HYPR_RULE" >> "$HYPR_RULES"
    echo "Hyprland Waydroid rule added"
elif [[ ! -f "$HYPR_RULES" ]]; then
    echo "$HYPR_RULE" > "$HYPR_RULES"
    echo "Hyprland rules.conf created with Waydroid rule"
else
    echo "Hyprland Waydroid rule already present — skipping"
fi

# ==========================================
# Zsh function: hide_waydroid
# ==========================================
ZSH_FUNCTIONS="$HOME/dots/zshrc/functions"
FUNC_MARKER="hide_waydroid()"

if [[ -f "$ZSH_FUNCTIONS" ]] && grep -qF "$FUNC_MARKER" "$ZSH_FUNCTIONS"; then
    echo "hide_waydroid function already present — skipping"
else
    cat >> "$ZSH_FUNCTIONS" <<'EOF'

# Waydroid Hider logic
hide_waydroid() {
  sh -c 'find "$HOME/.local/share/applications" -name "waydroid.*.desktop" -exec grep -L "NoDisplay=true" {} + | xargs -I {} sed -i "/\[Desktop Entry\]/a NoDisplay=true" {}' 2>/dev/null
}
EOF
    echo "hide_waydroid function added to zshrc/functions"
fi

# ==========================================
# Zsh init: call hide_waydroid in background
# ==========================================
ZSH_INIT="$HOME/dots/zshrc/init"
INIT_MARKER="hide_waydroid >/dev/null 2>&1 &!"

if [[ -f "$ZSH_INIT" ]] && grep -qF "$INIT_MARKER" "$ZSH_INIT"; then
    echo "hide_waydroid init call already present — skipping"
else
    cat >> "$ZSH_INIT" <<'EOF'

# Run Waydroid Hider in background
hide_waydroid >/dev/null 2>&1 &!
EOF
    echo "hide_waydroid init call added to zshrc/init"
fi