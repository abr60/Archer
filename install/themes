#!/usr/bin/env bash
# =============================================================================
# themes.sh — Symlink themes → ~/.config/Archer/themes
#           — Symlink wallpapers from ~/Wallpapers/backgrounds/<theme>/
#             → ~/.config/Archer/themes/<theme>/backgrounds
#
# NOTE: ~/.local/share/Archer/ is a git repo managed by Omarchy.
#       Never touch its contents — doing so breaks `archer update`.
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/dots"
THEME_SOURCE="$DOTS_DIR/themes"
THEME_DEST="$HOME/.config/Archer/themes"
WALLPAPERS_BASE="$HOME/Wallpapers/backgrounds"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

# ==========================================
# 1. SYMLINK THEMES
# ==========================================
if [[ ! -d "$THEME_SOURCE" ]]; then
    echo "ERR: $THEME_SOURCE not found."
    exit 1
fi

mkdir -p "$THEME_DEST"

found=0
for theme_dir in "$THEME_SOURCE"/*/; do
    theme_name=$(basename "$theme_dir")
    theme_link="$THEME_DEST/$theme_name"

    if [[ -L "$theme_link" ]]; then
        rm "$theme_link"
    elif [[ -d "$theme_link" ]]; then
        rm -rf "$theme_link"
    fi

    ln -s "$theme_dir" "$theme_link"
    ok "Symlinked $theme_link → $theme_dir"
    (( found++ )) || true
done

if [[ "$found" -eq 0 ]]; then
    warn "No themes found in $THEME_SOURCE"
else
    ok "Symlinked $found theme(s) to $THEME_DEST"
fi

# ==========================================
# 2. SYMLINK WALLPAPERS → ~/.config/Archer/themes/<theme>/backgrounds
# ==========================================
if [[ ! -d "$WALLPAPERS_BASE" ]]; then
    warn "Wallpapers folder not found at $WALLPAPERS_BASE — skipping"
    exit 0
fi

found=0
for theme_wallpaper_dir in "$WALLPAPERS_BASE"/*/; do
    theme_name=$(basename "$theme_wallpaper_dir")
    backgrounds_link="$THEME_DEST/$theme_name/backgrounds"

    if [[ -L "$backgrounds_link" ]]; then
        rm "$backgrounds_link"
    elif [[ -d "$backgrounds_link" ]]; then
        rm -rf "$backgrounds_link"
    fi

    mkdir -p "$THEME_DEST/$theme_name"
    ln -s "$theme_wallpaper_dir" "$backgrounds_link"
    ok "Symlinked $backgrounds_link → $theme_wallpaper_dir"
    (( found++ )) || true
done

if [[ "$found" -eq 0 ]]; then
    warn "No wallpaper folders found in $WALLPAPERS_BASE"
else
    ok "Wallpapers symlinked for $found theme(s)"
fi