#!/usr/bin/env bash
# =============================================================================
# packages-pacman — Install official repo packages
# Reads INSTALL_MODE from environment: "minimal" or "complete"
# Failed packages are queued to /tmp/archer-pacman-fallback.txt
# for packages-aur to process via yay later.
# =============================================================================

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKGS_FILE="$SCRIPT_DIR/pkgs-pacman.txt"
PKGS_HEAVY="$SCRIPT_DIR/pkgs-pacman-heavy.txt"
INSTALL_MODE="${INSTALL_MODE:-minimal}"
FALLBACK_FILE="/tmp/archer-pacman-fallback.txt"
REPORT_DIR="$HOME/.local/state/Archer"
REPORT_FILE="$REPORT_DIR/install-report.txt"

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

msg()     { echo -e "${BLUE}==>${NC} $1"; }
ok()      { echo -e "${GREEN} ✓${NC} $1"; }
warn()    { echo -e "${YELLOW} !${NC} $1"; }
err()     { echo -e "${RED} ✗${NC} $1"; }
section() { echo -e "\n${BOLD}${CYAN}--- $1 ---${NC}"; }

# --- State tracking ---
TOTAL=0
INSTALLED=0
SKIPPED=0
declare -a PACMAN_FAILED=()
declare -a PACMAN_REDIRECTED=()
declare -a RETRY_LOG=()

# --- Setup ---
mkdir -p "$REPORT_DIR"
rm -f "$FALLBACK_FILE"

SECTION_START=$SECONDS

# Write report header
{
    echo "=============================================="
    echo " ARCHER INSTALLATION REPORT"
    echo "=============================================="
    echo " Date     : $(date '+%Y-%m-%d %H:%M:%S')"
    echo " Hostname : $(hostname)"
    echo " Kernel   : $(uname -r)"
    echo " Mode     : $INSTALL_MODE"
    echo "=============================================="
} > "$REPORT_FILE"

# --- Install with retry ---
try_pacman() {
    local pkg="$1"
    local attempt=1
    local max=3

    while [[ $attempt -le $max ]]; do
        if sudo pacman -S --needed --noconfirm "$pkg" 2>/dev/null; then
            return 0
        fi
        if sudo pacman -Si "$pkg" &>/dev/null; then
            warn "Network issue on $pkg (attempt $attempt/$max) — retrying in 5s..."
            RETRY_LOG+=("pacman|$pkg|attempt $attempt failed — network issue")
            sleep 5
            (( attempt++ ))
        else
            return 1
        fi
    done
    RETRY_LOG+=("pacman|$pkg|all $max attempts failed")
    return 1
}

# --- Core install function ---
install_from_file() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        warn "$file not found — skipping"
        return
    fi

    mapfile -t PKGS < <(grep -v '^\s*#' "$file" | grep -v '^\s*$' | awk '{print $1}')

    if [[ ${#PKGS[@]} -eq 0 ]]; then
        warn "No packages found in $file"
        return
    fi

    local count=${#PKGS[@]}
    local current=0
    TOTAL=$(( TOTAL + count ))

    section "$(basename "$file") — $count packages"

    for pkg in "${PKGS[@]}"; do
        (( current++ ))
        printf "${BLUE}[%d/%d]${NC} %s ... " "$current" "$count" "$pkg"

        if pacman -Q "$pkg" &>/dev/null; then
            echo -e "${CYAN}already installed${NC}"
            (( SKIPPED++ ))
            continue
        fi

        if try_pacman "$pkg"; then
            echo -e "${GREEN}installed${NC}"
            (( INSTALLED++ ))
        else
            echo -e "${YELLOW}not in pacman → queued for AUR${NC}"
            echo "$pkg" >> "$FALLBACK_FILE"
            PACMAN_REDIRECTED+=("$pkg")
        fi
    done
}

# --- Run ---
msg "Installing pacman packages (mode: $INSTALL_MODE)..."
install_from_file "$PKGS_FILE"

if [[ "$INSTALL_MODE" == "complete" ]]; then
    install_from_file "$PKGS_HEAVY"
fi

SECTION_DURATION=$(( SECONDS - SECTION_START ))

# --- Summary ---
section "Pacman Summary"
echo -e "  ${GREEN}Installed : $INSTALLED${NC}"
echo -e "  ${CYAN}Skipped   : $SKIPPED${NC} (already present)"
echo -e "  ${YELLOW}Queued    : ${#PACMAN_REDIRECTED[@]}${NC} (sent to AUR fallback)"
echo -e "  ${BLUE}Duration  : ${SECTION_DURATION}s${NC}"

# --- Write to report ---
{
    echo ""
    echo "=============================================="
    echo " PACMAN INSTALLATION"
    echo "=============================================="
    echo " Duration  : ${SECTION_DURATION}s"
    echo " Installed : $INSTALLED"
    echo " Skipped   : $SKIPPED (already present)"
    echo " Queued    : ${#PACMAN_REDIRECTED[@]} (sent to AUR fallback)"

    if [[ ${#RETRY_LOG[@]} -gt 0 ]]; then
        echo ""
        echo " Retry Attempts:"
        for entry in "${RETRY_LOG[@]}"; do
            IFS='|' read -r source pkg reason <<< "$entry"
            echo "   ~ $pkg : $reason"
        done
    fi
} >> "$REPORT_FILE"

ok "Pacman packages done"
