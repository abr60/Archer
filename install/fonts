#!/usr/bin/env bash
# =============================================================================
# fonts.sh — Install custom fonts to ~/.local/share/fonts
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/dots"
FONT_SOURCE="$DOTS_DIR/fonts"
FONT_DEST="$HOME/.local/share/fonts"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

if [[ ! -d "$FONT_SOURCE" ]]; then
    echo "ERR: $FONT_SOURCE not found."
    exit 1
fi

mkdir -p "$FONT_DEST"

# Copy fonts, skipping files that already exist at the destination
echo "  Copying fonts to $FONT_DEST..."
cp -rn "$FONT_SOURCE"/. "$FONT_DEST/" 2>/dev/null || true

# Update font cache
if command -v fc-cache &>/dev/null; then
    fc-cache -f && ok "Font cache updated"
else
    warn "fc-cache not found — please install fontconfig"
fi

ok "Font installation complete"