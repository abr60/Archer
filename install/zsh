#!/usr/bin/env bash
# =============================================================================
# zsh.sh — Install Oh My Zsh, plugins, symlink zshrc folder, set default shell
# =============================================================================

set -euo pipefail

DOTS_DIR="$HOME/dots"
ZSH_DOTS_DIR="$DOTS_DIR/zshrc"
ZSHRC_LINK="$HOME/zshrc"
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

# ==========================================
# 1. INSTALL OH MY ZSH
# ==========================================
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    echo "==> Installing Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    ok "Oh My Zsh installed"
else
    ok "Oh My Zsh already installed"
fi

# ==========================================
# 2. INSTALL ZSH PLUGINS
# ==========================================
if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
    git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \
        "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
    ok "Installed zsh-autosuggestions"
else
    ok "zsh-autosuggestions already installed"
fi

if [[ ! -d "$ZSH_CUSTOM/plugins/fast-syntax-highlighting" ]]; then
    git clone --depth=1 https://github.com/zdharma-continuum/fast-syntax-highlighting \
        "$ZSH_CUSTOM/plugins/fast-syntax-highlighting"
    ok "Installed fast-syntax-highlighting"
else
    ok "fast-syntax-highlighting already installed"
fi

# ==========================================
# 3. SYMLINK ZSHRC FOLDER → ~/zshrc
# ==========================================
if [[ -d "$ZSH_DOTS_DIR" ]]; then
    [[ -L "$ZSHRC_LINK" ]] && rm "$ZSHRC_LINK"
    [[ -d "$ZSHRC_LINK" && ! -L "$ZSHRC_LINK" ]] && rm -rf "$ZSHRC_LINK"

    ln -sf "$ZSH_DOTS_DIR" "$ZSHRC_LINK"
    ok "Symlinked ~/zshrc → $ZSH_DOTS_DIR"
else
    warn "zshrc folder not found at $ZSH_DOTS_DIR — skipping"
fi

# ==========================================
# 4. SYMLINK ~/.zshrc → ~/zshrc/rc
# ==========================================
if [[ -f "$ZSHRC_LINK/rc" ]]; then
    [[ -f "$HOME/.zshrc" && ! -L "$HOME/.zshrc" ]] && rm "$HOME/.zshrc"

    ln -sf "$ZSHRC_LINK/rc" "$HOME/.zshrc"
    ok "Symlinked ~/.zshrc → ~/zshrc/rc"
else
    warn "rc file not found at $ZSHRC_LINK/rc — skipping .zshrc symlink"
fi

# ==========================================
# 5. SET DEFAULT SHELL TO ZSH
# ==========================================
ZSH_PATH=$(command -v zsh 2>/dev/null || true)

if [[ -z "$ZSH_PATH" ]]; then
    warn "zsh not found — install it first via packages-pacman.sh"
    exit 0
fi

if [[ "$SHELL" != "$ZSH_PATH" ]]; then
    sudo chsh -s "$ZSH_PATH" "$USER" && ok "Default shell changed to $ZSH_PATH"
else
    ok "Shell already set to zsh"
fi