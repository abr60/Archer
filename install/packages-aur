#!/usr/bin/env bash
# =============================================================================
# packages-aur — Install AUR packages via yay
# Reads INSTALL_MODE from environment: "minimal" or "complete"
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKGS_FILE="$SCRIPT_DIR/pkgs-aur.txt"
PKGS_HEAVY="$SCRIPT_DIR/pkgs-aur-heavy.txt"
INSTALL_MODE="${INSTALL_MODE:-minimal}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN} ✓${NC} $1"; }
warn() { echo -e "${YELLOW} !${NC} $1"; }

if ! command -v yay &>/dev/null; then
    echo "==> yay not found — bootstrapping from AUR..."
    sudo pacman -S --needed --noconfirm git base-devel
    BUILD_DIR="$(mktemp -d)"
    git clone https://aur.archlinux.org/yay.git "$BUILD_DIR/yay"
    (cd "$BUILD_DIR/yay" && makepkg -si --noconfirm)
    rm -rf "$BUILD_DIR"
    ok "yay installed"
fi

install_from_file() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        warn "$file not found — skipping"
        return
    fi

    mapfile -t PKGS < <(grep -v '^\s*#' "$file" | grep -v '^\s*$' | awk '{print $1}')

    if [[ ${#PKGS[@]} -eq 0 ]]; then
        warn "No packages found in $file"
        return
    fi

    TO_INSTALL=()
    for pkg in "${PKGS[@]}"; do
        pacman -Q "$pkg" &>/dev/null || TO_INSTALL+=("$pkg")
    done

    if [[ ${#TO_INSTALL[@]} -eq 0 ]]; then
        ok "All packages from $(basename "$file") already installed"
        return
    fi

    echo "  Installing ${#TO_INSTALL[@]} packages from $(basename "$file") via yay..."
    yay -S --needed --noconfirm "${TO_INSTALL[@]}" || warn "Some packages failed — check output above"
    ok "$(basename "$file") done"
}

install_from_file "$PKGS_FILE"

if [[ "$INSTALL_MODE" == "complete" ]]; then
    install_from_file "$PKGS_HEAVY"
fi

ok "AUR packages done"
