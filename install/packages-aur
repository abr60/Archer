#!/usr/bin/env bash
# =============================================================================
# packages-aur — Install AUR packages via yay
# Reads INSTALL_MODE from environment: "minimal" or "complete"
# Also processes /tmp/archer-pacman-fallback.txt from packages-pacman.
# If a yay package fails, it tries pacman as fallback inline.
# Generates final install report at ~/.local/state/Archer/install-report.txt
# =============================================================================

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKGS_FILE="$SCRIPT_DIR/pkgs-aur.txt"
PKGS_HEAVY="$SCRIPT_DIR/pkgs-aur-heavy.txt"
INSTALL_MODE="${INSTALL_MODE:-minimal}"
FALLBACK_FILE="/tmp/archer-pacman-fallback.txt"
REPORT_DIR="$HOME/.local/state/Archer"
REPORT_FILE="$REPORT_DIR/install-report.txt"

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

msg()     { echo -e "${BLUE}==>${NC} $1"; }
ok()      { echo -e "${GREEN} ✓${NC} $1"; }
warn()    { echo -e "${YELLOW} !${NC} $1"; }
err()     { echo -e "${RED} ✗${NC} $1"; }
section() { echo -e "\n${BOLD}${CYAN}--- $1 ---${NC}"; }

# --- State tracking ---
TOTAL=0
INSTALLED=0
SKIPPED=0
declare -a AUR_FAILED=()
declare -a AUR_REDIRECTED=()        # AUR pkg that fell back to pacman
declare -a PACMAN_FALLBACK_OK=()    # pacman-queued pkgs installed via yay
declare -a PACMAN_FALLBACK_FAIL=()  # pacman-queued pkgs that failed yay too

mkdir -p "$REPORT_DIR"

# --- Bootstrap yay ---
bootstrap_yay() {
    msg "yay not found — bootstrapping from AUR..."
    sudo pacman -S --needed --noconfirm git base-devel || {
        err "Failed to install git/base-devel — cannot build yay"
        exit 1
    }

    local BUILD_DIR
    BUILD_DIR="$(mktemp -d)"

    git clone https://aur.archlinux.org/yay.git "$BUILD_DIR/yay" || {
        err "Failed to clone yay repository — check your network"
        rm -rf "$BUILD_DIR"
        exit 1
    }

    (cd "$BUILD_DIR/yay" && makepkg -si --noconfirm) || {
        err "Failed to build/install yay"
        rm -rf "$BUILD_DIR"
        exit 1
    }

    rm -rf "$BUILD_DIR"

    # Verify yay is now available
    if ! command -v yay &>/dev/null; then
        err "yay installation appeared to succeed but yay command not found"
        exit 1
    fi

    ok "yay installed and verified"
}

if ! command -v yay &>/dev/null; then
    bootstrap_yay
fi

# --- Retry-aware yay install ---
try_yay() {
    local pkg="$1"
    local attempt=1
    local max=3

    while [[ $attempt -le $max ]]; do
        if yay -S --needed --noconfirm "$pkg" 2>/dev/null; then
            return 0
        fi
        # Check if package exists in AUR at all
        if yay -Si "$pkg" &>/dev/null; then
            # Exists but failed — likely network
            warn "Network issue on $pkg (attempt $attempt/$max) — retrying in 5s..."
            sleep 5
            (( attempt++ ))
        else
            # Not in AUR
            return 1
        fi
    done
    return 1
}

# --- Retry-aware pacman install (for AUR fallback) ---
try_pacman() {
    local pkg="$1"
    local attempt=1
    local max=3

    while [[ $attempt -le $max ]]; do
        if sudo pacman -S --needed --noconfirm "$pkg" 2>/dev/null; then
            return 0
        fi
        if sudo pacman -Si "$pkg" &>/dev/null; then
            warn "Network issue on $pkg (attempt $attempt/$max) — retrying in 5s..."
            sleep 5
            (( attempt++ ))
        else
            return 1
        fi
    done
    return 1
}

# --- Core install function ---
install_from_file() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        warn "$file not found — skipping"
        return
    fi

    mapfile -t PKGS < <(grep -v '^\s*#' "$file" | grep -v '^\s*$' | awk '{print $1}')

    if [[ ${#PKGS[@]} -eq 0 ]]; then
        warn "No packages found in $file"
        return
    fi

    local count=${#PKGS[@]}
    local current=0
    TOTAL=$(( TOTAL + count ))

    section "$(basename "$file") — $count packages"

    for pkg in "${PKGS[@]}"; do
        (( current++ ))
        printf "${BLUE}[%d/%d]${NC} %s ... " "$current" "$count" "$pkg"

        # Already installed
        if pacman -Q "$pkg" &>/dev/null; then
            echo -e "${CYAN}already installed${NC}"
            (( SKIPPED++ ))
            continue
        fi

        # Try yay first
        if try_yay "$pkg"; then
            echo -e "${GREEN}installed via AUR${NC}"
            (( INSTALLED++ ))
        else
            # Not in AUR — try pacman fallback
            printf "${YELLOW}not in AUR → trying pacman ...${NC} "
            if try_pacman "$pkg"; then
                echo -e "${GREEN}installed via pacman fallback${NC}"
                AUR_REDIRECTED+=("$pkg")
                (( INSTALLED++ ))
            else
                echo -e "${RED}failed everywhere${NC}"
                AUR_FAILED+=("$pkg")
            fi
        fi
    done
}

# --- Run AUR installs ---
msg "Installing AUR packages (mode: $INSTALL_MODE)..."
install_from_file "$PKGS_FILE"

if [[ "$INSTALL_MODE" == "complete" ]]; then
    install_from_file "$PKGS_HEAVY"
fi

# --- Process pacman fallbacks ---
if [[ -f "$FALLBACK_FILE" ]] && [[ -s "$FALLBACK_FILE" ]]; then
    mapfile -t FALLBACKS < "$FALLBACK_FILE"
    local_count=${#FALLBACKS[@]}

    section "Pacman Fallbacks — $local_count packages queued from packages-pacman"

    local current=0
    for pkg in "${FALLBACKS[@]}"; do
        (( current++ ))
        printf "${BLUE}[%d/%d]${NC} %s ... " "$current" "$local_count" "$pkg"

        if pacman -Q "$pkg" &>/dev/null; then
            echo -e "${CYAN}already installed${NC}"
            continue
        fi

        if try_yay "$pkg"; then
            echo -e "${GREEN}installed via AUR fallback${NC}"
            PACMAN_FALLBACK_OK+=("$pkg")
            (( INSTALLED++ ))
        else
            echo -e "${RED}failed in AUR too${NC}"
            PACMAN_FALLBACK_FAIL+=("$pkg")
        fi
    done

    rm -f "$FALLBACK_FILE"
fi

# --- Summary ---
section "AUR Summary"
echo -e "  ${GREEN}Installed : $INSTALLED${NC}"
echo -e "  ${CYAN}Skipped   : $SKIPPED${NC} (already present)"
echo -e "  ${YELLOW}Redirected: ${#AUR_REDIRECTED[@]}${NC} (AUR→pacman fallback used)"
echo -e "  ${RED}Failed    : ${#AUR_FAILED[@]}${NC} (not found anywhere)"

# --- Write full report ---
{
    echo ""
    echo "=============================================="
    echo " AUR INSTALLATION"
    echo "=============================================="
    echo " Installed : $INSTALLED"
    echo " Skipped   : $SKIPPED (already present)"
    echo " Redirected: ${#AUR_REDIRECTED[@]} (AUR→pacman fallback used)"
    echo " Failed    : ${#AUR_FAILED[@]} (not found anywhere)"

    echo ""
    echo "=============================================="
    echo " FALLBACK REDIRECTS (auto-fixed)"
    echo "=============================================="

    if [[ ${#PACMAN_FALLBACK_OK[@]} -gt 0 ]]; then
        echo " Pacman → AUR (was in pkgs-pacman.txt, found in AUR):"
        for pkg in "${PACMAN_FALLBACK_OK[@]}"; do
            echo "   + $pkg"
        done
    else
        echo " Pacman → AUR : none"
    fi

    if [[ ${#AUR_REDIRECTED[@]} -gt 0 ]]; then
        echo " AUR → Pacman (was in pkgs-aur.txt, found in pacman):"
        for pkg in "${AUR_REDIRECTED[@]}"; do
            echo "   + $pkg"
        done
    else
        echo " AUR → Pacman : none"
    fi

    echo ""
    echo "=============================================="
    echo " PACMAN FAILURES (not found anywhere)"
    echo "=============================================="
    if [[ ${#PACMAN_FALLBACK_FAIL[@]} -gt 0 ]]; then
        for pkg in "${PACMAN_FALLBACK_FAIL[@]}"; do
            echo "   ✗ $pkg"
        done
        echo ""
        echo " → These were listed in pkgs-pacman.txt but not found"
        echo "   in official repos or AUR. Please fix your package list."
    else
        echo " None — all pacman packages resolved successfully."
    fi

    echo ""
    echo "=============================================="
    echo " AUR FAILURES (not found anywhere)"
    echo "=============================================="
    if [[ ${#AUR_FAILED[@]} -gt 0 ]]; then
        for pkg in "${AUR_FAILED[@]}"; do
            echo "   ✗ $pkg"
        done
        echo ""
        echo " → These were listed in pkgs-aur.txt but not found"
        echo "   in AUR or official repos. Please fix your package list."
    else
        echo " None — all AUR packages resolved successfully."
    fi

    echo ""
    echo "=============================================="
    echo " END OF REPORT"
    echo "=============================================="
} >> "$REPORT_FILE"

# --- Show report location ---
echo ""
msg "Install report saved to: $REPORT_FILE"
ok "AUR packages done"
