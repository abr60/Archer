#!/bin/bash
source "$HOME/.config/hypr/assets/lib/helpers.sh"
clear

# ── Logo ────────────────────────────────────────────────────────────────────
cat "$HOME/.config/hypr/assets/ANSI LOGO/music-downloader.txt" 2>/dev/null || echo "Music Downloader"

# ── Info Box ────────────────────────────────────────────────────────────────
gum style --border rounded --border-foreground 5 --padding "1 2" \
  "" \
  "• Automatically embeds Cover Art & Tags" \
  "• Targets local MPD library structure (~/Music)" \
  "" \
  "$(gum style --foreground 8 "Powered by yt-dlp & mpc")"

echo

# ── URL Input & Validation ──────────────────────────────────────────────────
clip_url=$(wl-paste 2>/dev/null || true)
[[ "$clip_url" != http* ]] && clip_url=""

url=$(gum input --prompt "Music URL: " --placeholder "YouTube, SoundCloud, Spotify link..." --value "$clip_url")
[[ -z "$url" ]] && { log_info "Cancelled"; exit 0; }

echo
if ! spinner "Validating URL..." yt-dlp --dump-json --quiet --no-warnings --playlist-items 1 "$url" > /dev/null 2>&1;
then
  log_error "URL not supported or invalid"
  exit 1
fi

title=$(yt-dlp --get-title --quiet --no-warnings --playlist-items 1 "$url" 2>/dev/null || echo "Unknown Track")
log_success "Found: $title"

# ── Playlist Detection ───────────────────────────────────────────────────────
echo
is_playlist=false
if echo "$url" | grep -q "list="; then
  playlist_title=$(yt-dlp --flat-playlist --dump-single-json --quiet --no-warnings "$url" 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('title','Playlist'))" 2>/dev/null)
  playlist_count=$(yt-dlp --flat-playlist --dump-single-json --quiet --no-warnings "$url" 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('entries',[])))" 2>/dev/null)
  log_info "Playlist detected: $playlist_title ($playlist_count items)"
  echo
  playlist_choice=$(gum choose --header "What would you like to download?" "This track only" "Entire playlist")
  [[ -z "$playlist_choice" ]] && exit 0
  [[ "$playlist_choice" == "Entire playlist" ]] && is_playlist=true
fi

# ── Audio Profile Setup ─────────────────────────────────────────────────────
echo
audio_format=$(gum choose --header "Select audio format" "FLAC (Lossless)" "Opus" "M4A" "MP3")
[[ -z "$audio_format" ]] && { log_info "Cancelled"; exit 0; }

case "$audio_format" in
  "FLAC (Lossless)") audio_format_lower="flac" ;;
  *)                 audio_format_lower=$(echo "$audio_format" | tr '[:upper:]' '[:lower:]') ;;
esac

echo
if [[ "$audio_format_lower" == "flac" ]]; then
  audio_quality="0"
  log_info "FLAC configuration: Preset locked to maximum compression (0)"
else
  quality_choice=$(gum choose --header "Select target bitrate" "320k (Excellent)" "192k (Standard)" "128k (Compact)")
  [[ -z "$quality_choice" ]] && quality_choice="192k (Standard)"
  case "$quality_choice" in
    "320k (Excellent)") audio_quality="320k" ;;
    "192k (Standard)")  audio_quality="192k" ;;
    "128k (Compact)")   audio_quality="128k" ;;
  esac
fi

# ── Extraction & Downloader Execution ───────────────────────────────────────
audio_root="$HOME/Music"
mkdir -p "$audio_root"

metadata_flags=(
  --extract-audio
  --audio-format "$audio_format_lower"
  --audio-quality "$audio_quality"
  --embed-thumbnail
  --embed-metadata
  --add-metadata
  --parse-metadata "%(uploader)s:%(artist)s"
  --parse-metadata "%(title)s:%(title)s"
)

echo
if $is_playlist;
then
  out_template="$audio_root/%(artist)s/%(album)s/%(track_number)02d - %(title)s.%(ext)s"
  log_step "Downloading structured playlist ($audio_format)..."
  
  # Runs cleanly using gum spin to avoid cluttered terminal text
  gum spin --spinner dot --title "Processing audio pipeline and parsing metadata streams..." -- \
    yt-dlp "${metadata_flags[@]}" --no-warnings --yes-playlist --ignore-errors -o "$out_template" "$url"
  
  log_success "Playlist downloaded and mapped to library under $audio_root"
else
  out_template="$audio_root/%(artist)s/Singles/%(title)s.%(ext)s"
  log_step "Downloading isolated track ($audio_format)..."
  
  gum spin --spinner dot --title "Extracting stream, embedding art, and creating local metadata frame..." -- \
    yt-dlp "${metadata_flags[@]}" --no-warnings --playlist-items 1 -o "$out_template" "$url"
  
  if [[ $? -ne 0 ]]; then
    log_error "Audio extraction failed"
    exit 1
  fi
  log_success "Track saved safely to structural singles archive"
fi

# ── Sync Hook ───────────────────────────────────────────────────────────────
echo
log_step "Signaling background MPD daemon to update indexing database..."
mpc update

# ── Exit Countdown ──────────────────────────────────────────────────────────
echo
gum style --foreground 2 "  ✓ Processing Complete!"
echo
for i in $(seq 5 -1 1); do
  printf "\r  Closing window in %d seconds... (or press any key to close)  " "$i"
  read -r -s -n1 -t1 key && break
done
echo